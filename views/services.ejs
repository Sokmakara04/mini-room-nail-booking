<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= salonName %> | <%= lang === 'km' ? 'សេវាកម្មក្រចកដៃ' : 'Fingernail Services Menu' %></title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="has-bottom-nav">
  <!-- Top Navigation (Compact, App-Like) -->
  <nav class="salon-nav">
    <div class="container d-flex align-items-center justify-content-between position-relative">
      <a class="salon-brand" href="/?lang=<%= lang %>">
        <span class="brand-logo-icon">💅</span>
        <span><%= salonName %></span>
      </a>

      <div class="d-flex align-items-center gap-2 gap-md-3">
        <a class="nav-link d-none d-md-inline" href="/?lang=<%= lang %>"><%= lang === 'km' ? 'ទំព័រដើម' : 'Home' %></a>
        <a class="nav-link active d-none d-md-inline" href="/services?lang=<%= lang %>"><%= lang === 'km' ? 'សេវាកម្ម' : 'Services' %></a>
        <a class="nav-link d-none d-md-inline" href="/?lang=<%= lang %>#location"><%= lang === 'km' ? 'ទីតាំងហាង' : 'Our Location' %></a>
        <a class="nav-link d-none d-md-inline" href="/status?lang=<%= lang %>"><%= lang === 'km' ? 'ពិនិត្យការកក់' : 'Check Status' %></a>
        
        <div class="lang-switch">
          <a href="?lang=en" class="<%= lang === 'en' ? 'active' : '' %>" aria-label="English">EN</a>
          <a href="?lang=km" class="<%= lang === 'km' ? 'active' : '' %>" aria-label="Khmer">ខ្មែរ</a>
        </div>

        <a class="btn-nail btn-nail-sm d-none d-sm-inline-flex" href="/book?lang=<%= lang %>">
          <%= lang === 'km' ? 'កក់ណាត់ជួប' : 'Book Appointment' %>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button class="salon-menu-toggle" id="salonMenuToggle" type="button" aria-label="<%= lang==='km' ? 'បើកបញ្ជីម៉ឺនុយ' : 'Toggle navigation' %>" aria-expanded="false">
          ☰
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div class="salon-mobile-drawer" id="salonMobileDrawer">
      <div class="salon-mobile-nav-links">
        <a class="nav-link" href="/?lang=<%= lang %>">
          🏠 <%= lang==='km' ? 'ទំព័រដើម' : 'Home' %>
        </a>
        <a class="nav-link active" href="/services?lang=<%= lang %>">
          💅 <%= lang==='km' ? 'សេវាកម្មក្រចក' : 'Nail Services' %>
        </a>
        <a class="nav-link" href="/?lang=<%= lang %>#location">
          📍 <%= lang==='km' ? 'ទីតាំងហាង' : 'Our Location' %>
        </a>
        <a class="nav-link" href="/status?lang=<%= lang %>">
          🔍 <%= lang==='km' ? 'ពិនិត្យការកក់' : 'Check Status' %>
        </a>
        <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#profileModal">
          👤 <%= lang==='km' ? 'ព័ត៌មានអតិថិជន & ហាង' : 'Profile & Salon Info' %>
        </a>
      </div>
      <div class="salon-mobile-actions">
        <a class="btn-nail w-100 py-3 justify-content-center" href="/book?lang=<%= lang %>">
          📅 <%= lang==='km' ? 'កក់ណាត់ជួបឥឡូវនេះ' : 'Book Appointment' %>
        </a>
      </div>
    </div>
  </nav>

  <main class="container py-3 py-md-4">
    <div class="text-center max-w-700 mx-auto mb-3 mb-md-4">
      <span class="hero-eyebrow">💅 <%= lang === 'km' ? 'តារាងសេវាកម្មក្រចកដៃផ្តាច់មុខ' : 'FINGERNAIL SERVICES ONLY' %></span>
      <h1 class="fw-bold mt-1 h2"><%= lang === 'km' ? 'សេវាកម្មថែទាំនិងរចនាម៉ូដក្រចកដៃ' : 'Signature Fingernail Services' %></h1>
      <p class="text-secondary small mb-0"><%= lang === 'km' ? 'គ្រប់សេវាកម្មទាំងអស់ត្រូវបានបម្រើដោយជាងជំនាញ ជាមួយសម្ភារៈគ្មានជាតិពុល និងអនាម័យខ្ពស់បំផុត។' : 'Expert care for your hands and nails. We specialize only in premium fingernail treatments and hand care.' %></p>
    </div>

    <!-- Category Filter Navigation (Smooth Swipeable Chips) -->
    <div class="d-flex align-items-center gap-2 overflow-x-auto pb-2 mb-3 mb-md-4 justify-content-start justify-content-md-center px-1" style="scrollbar-width: none;">
      <button type="button" class="filter-chip-btn active" data-filter="all">
        <span>✨ <%= lang === 'km' ? 'ទាំងអស់' : 'All Services' %></span>
        <span class="badge bg-secondary-subtle text-dark ms-1"><%= services.length %></span>
      </button>
      <% (serviceGroups || []).forEach(g => { 
           const groupCount = services.filter(s => String(s.groupId) === String(g.id)).length;
           if (groupCount > 0) {
      %>
        <button type="button" class="filter-chip-btn" data-filter="<%= g.id %>">
          <span><%= lang === 'km' ? g.nameKm : g.name %></span>
          <span class="badge bg-secondary-subtle text-dark ms-1"><%= groupCount %></span>
        </button>
      <% } }) %>
    </div>

    <!-- Grouped Services List -->
    <div id="serviceGroupsContainer">
      <% 
        const groupsToDisplay = (serviceGroups && serviceGroups.length > 0) 
          ? serviceGroups.filter(g => services.some(s => String(s.groupId) === String(g.id)))
          : [{ id: 'grp-all', name: 'All Services', nameKm: 'សេវាកម្មទាំងអស់' }];

        groupsToDisplay.forEach(g => {
          const groupServices = services.filter(s => String(s.groupId) === String(g.id));
          if (groupServices.length > 0) {
      %>
        <section class="service-group-section mb-4 mb-md-5" data-group="<%= g.id %>" id="group-<%= g.id %>">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-2 border-bottom">
            <div>
              <h2 class="h4 fw-bold mb-1 text-dark">
                💅 <%= lang === 'km' ? g.nameKm : g.name %>
                <span class="text-secondary small fw-normal ms-1">(<%= lang === 'km' ? g.name : g.nameKm %>)</span>
              </h2>
              <% if (g.description || g.descriptionKm) { %>
                <p class="text-secondary small mb-0"><%= lang === 'km' ? (g.descriptionKm || g.description) : (g.description || g.descriptionKm) %></p>
              <% } %>
            </div>
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
              <%= groupServices.length %> <%= lang === 'km' ? 'សេវាកម្ម' : 'items' %>
            </span>
          </div>

          <div class="row g-3 g-md-4">
            <% groupServices.forEach(s => { %>
              <div class="col-12 col-md-6 col-lg-4 service-card-col">
                <div class="service-card h-100 d-flex flex-column">
                  <div class="service-img-wrap">
                    <img src="<%= s.imageUrl || 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=600&q=80' %>" alt="<%= s.name %>" loading="lazy">
                    <span class="service-price-badge">$<%= s.price %></span>
                  </div>
                  <div class="service-body d-flex flex-column flex-grow-1">
                    <h3 class="service-title"><%= lang === 'km' ? s.nameKm : s.name %></h3>
                    <div class="service-duration mb-2">
                      ⏱️ <%= s.durationMinutes %> <%= lang === 'km' ? 'នាទី' : 'mins' %>
                    </div>
                    <p class="service-desc flex-grow-1"><%= lang === 'km' ? (s.descriptionKm || s.description) : (s.description || s.descriptionKm) %></p>
                    <a href="/book?serviceId=<%= s._id %>&lang=<%= lang %>" class="btn-nail w-100 mt-auto">
                      📅 <%= lang === 'km' ? 'កក់សេវាកម្មនេះ' : 'Book This Service' %>
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      <% } }) %>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="container text-center">
      <p class="mb-1"><strong><%= salonName %></strong></p>
      <p class="small text-secondary mb-0">
        © <%= new Date().getFullYear() %> <%= salonName %>. <%= lang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង' : 'All rights reserved.' %>
        • <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-secondary">📍 <%= lang === 'km' ? 'ទីតាំងហាង (Google Maps)' : 'Our Location (Google Maps)' %></a>
      </p>
    </div>
  </footer>

  <!-- Customer Profile & Salon Info Modal -->
  <div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-lg);">
        <div class="modal-header border-bottom pb-3" style="background: var(--bg-sand); border-top-left-radius: var(--radius-lg); border-top-right-radius: var(--radius-lg);">
          <div class="d-flex align-items-center gap-2">
            <span class="fs-4">👤</span>
            <div>
              <h5 class="modal-title fw-bold h6 mb-0" id="profileModalLabel"><%= lang === 'km' ? 'ព័ត៌មានអតិថិជន & ហាង' : 'Customer Profile & Salon' %></h5>
              <small class="text-muted"><%= salonName %></small>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-3 p-sm-4">
          <div class="glass-card-subtle mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="fw-bold small text-dark">📋 <%= lang === 'km' ? 'ព័ត៌មានដែលបានរក្សាទុក' : 'Saved Customer Info' %></span>
              <span class="badge bg-light text-secondary border small"><%= lang === 'km' ? 'ស្វ័យប្រវត្តិ' : 'Auto-Saved' %></span>
            </div>
            <div id="profileSavedDetails">
              <p class="small text-muted mb-0" id="profileNoSavedInfo">
                <%= lang === 'km' ? 'ព័ត៌មានឈ្មោះ និងលេខទូរស័ព្ទរបស់អ្នកនឹងត្រូវបានរក្សាទុកដោយស្វ័យប្រវត្តិនៅពេលកក់លើកដំបូង។' : 'Your name and phone number will be remembered here after your first booking.' %>
              </p>
              <div id="profileSavedContent" class="d-none">
                <div class="small"><strong><%= lang === 'km' ? 'ឈ្មោះ៖' : 'Name:' %></strong> <span id="profNameDisplay">-</span></div>
                <div class="small"><strong><%= lang === 'km' ? 'លេខទូរស័ព្ទ៖' : 'Phone:' %></strong> <span id="profPhoneDisplay">-</span></div>
              </div>
            </div>
          </div>

          <div class="d-flex flex-column gap-2 mb-3">
            <a href="/status?lang=<%= lang %>" class="btn btn-outline-dark d-flex align-items-center justify-content-between py-2 px-3 rounded-3" style="min-height: 46px;">
              <span class="d-flex align-items-center gap-2">
                <span>🔍</span>
                <span class="fw-bold small"><%= lang === 'km' ? 'មើលប្រវត្តិនិងស្ថានភាពការកក់' : 'View My Appointments' %></span>
              </span>
              <span>→</span>
            </a>
            <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger d-flex align-items-center justify-content-between py-2 px-3 rounded-3" style="min-height: 46px;">
              <span class="d-flex align-items-center gap-2">
                <span>🗺️</span>
                <span class="fw-bold small"><%= lang === 'km' ? 'មើលផ្លូវទៅហាង (Google Maps)' : 'Get Directions (Google Maps)' %></span>
              </span>
              <span>↗</span>
            </a>
            <a href="https://t.me/miniroomnail_bot" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-flex align-items-center justify-content-between py-2 px-3 rounded-3" style="min-height: 46px;">
              <span class="d-flex align-items-center gap-2">
                <span>✈️</span>
                <span class="fw-bold small"><%= lang === 'km' ? 'ជំនួយការកក់ Telegram Bot' : 'Telegram Booking Bot' %></span>
              </span>
              <span>↗</span>
            </a>
          </div>

          <div class="pt-2 border-top small text-secondary">
            <div>⏰ <strong><%= lang === 'km' ? 'ម៉ោងបើកហាង៖' : 'Hours:' %></strong> <%= settings.openingTime %> - <%= settings.closingTime %> (<%= lang === 'km' ? 'រៀងរាល់ថ្ងៃ' : 'Mon - Sun' %>)</div>
            <% if (settings.salonPhone) { %>
              <div class="mt-1">📞 <strong><%= lang === 'km' ? 'លេខទូរស័ព្ទ៖' : 'Phone:' %></strong> <a href="tel:<%= settings.salonPhone %>" class="text-decoration-none text-dark"><%= settings.salonPhone %></a></div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile App Bottom Navigation Bar -->
  <nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
    <a href="/?lang=<%= lang %>" class="bottom-nav-item">
      <span class="bottom-nav-icon">🏠</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'ទំព័រដើម' : 'Home' %></span>
    </a>
    <a href="/services?lang=<%= lang %>" class="bottom-nav-item active">
      <span class="bottom-nav-icon">💅</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'សេវាកម្ម' : 'Services' %></span>
    </a>
    <a href="/book?lang=<%= lang %>" class="bottom-nav-item book-highlight">
      <span class="bottom-nav-icon-wrap">📅</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'កក់ណាត់' : 'Book' %></span>
    </a>
    <a href="/status?lang=<%= lang %>" class="bottom-nav-item">
      <span class="bottom-nav-icon">🔍</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'ការកក់' : 'Bookings' %></span>
    </a>
    <a href="#" class="bottom-nav-item" data-bs-toggle="modal" data-bs-target="#profileModal">
      <span class="bottom-nav-icon">👤</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'គណនី' : 'Profile' %></span>
    </a>
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Category pill filtering
    document.querySelectorAll('.filter-chip-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-chip-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        const sections = document.querySelectorAll('.service-group-section');

        sections.forEach(sec => {
          if (filter === 'all' || sec.getAttribute('data-group') === filter) {
            sec.style.display = 'block';
          } else {
            sec.style.display = 'none';
          }
        });
      });
    });

    // Mobile Drawer Toggle
    (function() {
      const toggleBtn = document.getElementById('salonMenuToggle');
      const drawer = document.getElementById('salonMobileDrawer');
      if (toggleBtn && drawer) {
        toggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const isOpen = drawer.classList.toggle('show');
          toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          toggleBtn.innerHTML = isOpen ? '✕' : '☰';
        });
        document.addEventListener('click', function(e) {
          if (!drawer.contains(e.target) && !toggleBtn.contains(e.target) && drawer.classList.contains('show')) {
            drawer.classList.remove('show');
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.innerHTML = '☰';
          }
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && drawer.classList.contains('show')) {
            drawer.classList.remove('show');
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.innerHTML = '☰';
          }
        });
      }

      // Customer info from localStorage
      try {
        const savedName = localStorage.getItem('miniroom_customer_name');
        const savedPhone = localStorage.getItem('miniroom_customer_phone');
        if (savedName || savedPhone) {
          const noSaved = document.getElementById('profileNoSavedInfo');
          const savedWrap = document.getElementById('profileSavedContent');
          const nameDisp = document.getElementById('profNameDisplay');
          const phoneDisp = document.getElementById('profPhoneDisplay');
          if (noSaved && savedWrap && nameDisp && phoneDisp) {
            noSaved.classList.add('d-none');
            savedWrap.classList.remove('d-none');
            nameDisp.innerText = savedName || '-';
            phoneDisp.innerText = savedPhone || '-';
          }
        }
      } catch (e) {}
    })();
  </script>
</body>
</html>
