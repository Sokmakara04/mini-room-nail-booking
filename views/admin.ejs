<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Mini Room Nail & Eyelash | Admin Dashboard</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    .nav-tabs .nav-link {
      font-weight: 700;
      color: var(--text-muted);
      border: none;
      padding: 0.65rem 1.1rem;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      white-space: nowrap;
    }

    .nav-tabs .nav-link.active {
      color: var(--primary);
      background: #ffffff;
      border-bottom: 3px solid var(--primary);
    }

    /* =============================================
       Dual Image Input Styles
       ============================================= */
    .img-mode-switcher {
      display: inline-flex;
      background: #f1f1f1;
      border-radius: 8px;
      padding: 3px;
      gap: 2px;
    }
    .img-mode-btn {
      border: none;
      background: transparent;
      border-radius: 6px;
      padding: 6px 16px;
      font-size: 0.82rem;
      font-weight: 600;
      color: #6c757d;
      cursor: pointer;
      transition: all 0.18s;
    }
    .img-mode-btn.active {
      background: #fff;
      color: #c2185b;
      box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    }
    .img-mode-btn:hover:not(.active) {
      color: #333;
      background: rgba(255,255,255,0.6);
    }
    .img-preview-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #fafafa;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 8px 12px;
      margin-top: 6px;
    }
    .img-preview {
      width: 72px;
      height: 72px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid #ddd;
      flex-shrink: 0;
    }
    .img-current-preview {
      width: 64px;
      height: 64px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid #ddd;
    }
    .img-preview-label {
      font-size: 0.78rem;
      color: #555;
    }
    .upload-drop-zone {
      border: 2px dashed #c2185b;
      border-radius: 10px;
      padding: 24px 16px;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: background 0.18s, border-color 0.18s;
      background: #fff5f8;
    }
    .upload-drop-zone:hover,
    .upload-drop-zone.dragover {
      background: #ffe0eb;
      border-color: #880e4f;
    }
    .upload-drop-icon { font-size: 1.8rem; margin-bottom: 4px; }
    .upload-drop-text { font-size: 0.88rem; color: #333; font-weight: 500; }
    .upload-drop-hint { font-size: 0.76rem; color: #888; margin-top: 2px; }
    .upload-file-input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }
    .upload-progress-bar-wrap {
      margin-top: 8px;
    }
    .upload-progress-text {
      font-size: 0.76rem;
      color: #555;
      margin-top: 3px;
      text-align: center;
    }
    .upload-error-msg {
      margin-top: 6px;
      color: #dc3545;
      font-size: 0.82rem;
      background: #fff5f5;
      border: 1px solid #f5c6cb;
      border-radius: 6px;
      padding: 6px 10px;
    }
    .btn-img-clear {
      background: none;
      border: none;
      color: #c2185b;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      padding: 0;
      text-decoration: underline;
    }
    .btn-img-clear:hover { color: #880e4f; }
  </style>
</head>

<body style="background: #f8f3f4;">
  <!-- Admin Navbar -->
  <nav class="salon-nav bg-white position-relative">
    <div class="container d-flex justify-content-between align-items-center gap-2">
      <div class="d-flex align-items-center gap-2">
        <a class="salon-brand" href="/admin">
          💅 <%= salonName %> <span class="badge bg-dark fs-6 ms-2 d-none d-sm-inline">Admin Panel</span>
        </a>
      </div>
      <div class="d-flex align-items-center gap-2">
        <div class="d-none d-md-flex align-items-center gap-2">
          <a href="/" class="btn btn-outline-dark btn-sm" target="_blank" title="View customer-facing website">🌐 View Website</a>
          <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer" title="Google Maps Location">📍 Maps</a>
          <a href="https://t.me/miniroomnail_bot" class="btn btn-sm btn-outline-primary" target="_blank" title="Telegram Booking Bot">✈️ Bot Chat</a>
        </div>
        <!-- Mobile Drawer Hamburger Toggle -->
        <button class="salon-menu-toggle d-md-none" id="adminMenuToggle" type="button" aria-label="Toggle admin navigation menu" aria-expanded="false">
          ☰
        </button>
      </div>
    </div>

    <!-- Admin Mobile Navigation Drawer -->
    <div class="salon-mobile-drawer" id="adminMobileDrawer">
      <div class="salon-mobile-nav-links">
        <div class="small fw-bold text-muted px-2 py-1 text-uppercase" style="letter-spacing: 0.05em;">Admin Modules</div>
        <button type="button" class="nav-link border-0 bg-transparent text-start w-100 admin-drawer-tab-btn <%= activeTab === 'bookings' ? 'active' : '' %>" data-tab-target="bookings-tab">
          📅 Appointments (<%= bookings.length %>)
        </button>
        <button type="button" class="nav-link border-0 bg-transparent text-start w-100 admin-drawer-tab-btn <%= activeTab === 'calendar' ? 'active' : '' %>" data-tab-target="calendar-tab">
          🗓️ Booking Calendar
        </button>
        <button type="button" class="nav-link border-0 bg-transparent text-start w-100 admin-drawer-tab-btn <%= activeTab === 'services' ? 'active' : '' %>" data-tab-target="services-tab">
          💅 Fingernail Services (<%= services.length %>)
        </button>
        <button type="button" class="nav-link border-0 bg-transparent text-start w-100 admin-drawer-tab-btn <%= activeTab === 'groups' ? 'active' : '' %>" data-tab-target="groups-tab">
          📁 Service Groups (<%= (typeof serviceGroups !== 'undefined' && serviceGroups) ? serviceGroups.length : 0 %>)
        </button>
        <button type="button" class="nav-link border-0 bg-transparent text-start w-100 admin-drawer-tab-btn <%= activeTab === 'schedule' ? 'active' : '' %>" data-tab-target="schedule-tab">
          ⚙️ Salon Schedule & Hours
        </button>
      </div>
      <div class="salon-mobile-actions">
        <a href="/" class="btn btn-outline-dark btn-sm w-100 py-2 justify-content-center" target="_blank">🌐 View Customer Website</a>
        <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" class="btn btn-sm btn-outline-secondary w-100 py-2 justify-content-center" target="_blank" rel="noopener noreferrer">📍 Google Maps</a>
        <a href="https://t.me/miniroomnail_bot" class="btn btn-sm btn-outline-primary w-100 py-2 justify-content-center" target="_blank">✈️ Telegram Booking Bot</a>
      </div>
    </div>
  </nav>

  <main class="container py-3 py-md-4">
    <!-- Top Statistics Grid -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">TODAY'S BOOKINGS</div>
        <div class="admin-stat-val text-primary">
          <%= stats.todayCount %>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">PENDING CONFIRMATION</div>
        <div class="admin-stat-val text-warning">
          <%= stats.pendingCount %>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">CONFIRMED APPOINTMENTS</div>
        <div class="admin-stat-val text-success">
          <%= stats.confirmedCount %>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">TOTAL ALL TIME</div>
        <div class="admin-stat-val text-dark">
          <%= stats.totalCount %>
        </div>
      </div>
    </div>

    <!-- Flash message alert -->
    <% if (typeof alertMessage !=='undefined' && alertMessage) { %>
      <div class="alert alert-<%= alertType || 'info' %> alert-dismissible fade show" role="alert">
        <%= alertMessage %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
      <% } %>

        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs nav-tabs-responsive mb-3 mb-md-4" id="adminTabs" role="tablist">
          <li class="nav-item">
            <button class="nav-link <%= activeTab === 'bookings' ? 'active' : '' %>" id="bookings-tab"
              data-bs-toggle="tab" data-bs-target="#bookings-pane" type="button">
              📅 Appointments (<%= bookings.length %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link <%= activeTab === 'calendar' ? 'active' : '' %>" id="calendar-tab"
              data-bs-toggle="tab" data-bs-target="#calendar-pane" type="button">
              🗓️ Booking Calendar
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link <%= activeTab === 'services' ? 'active' : '' %>" id="services-tab"
              data-bs-toggle="tab" data-bs-target="#services-pane" type="button">
              💅 Fingernail Services (<%= services.length %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link <%= activeTab === 'groups' ? 'active' : '' %>" id="groups-tab"
              data-bs-toggle="tab" data-bs-target="#groups-pane" type="button">
              📁 Service Groups (<%= (typeof serviceGroups !== 'undefined' && serviceGroups) ? serviceGroups.length : 0 %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link <%= activeTab === 'schedule' ? 'active' : '' %>" id="schedule-tab"
              data-bs-toggle="tab" data-bs-target="#schedule-pane" type="button">
              ⚙️ Salon Schedule & Hours
            </button>
          </li>
        </ul>

        <div class="tab-content" id="adminTabsContent">
          <!-- TAB 1: APPOINTMENTS -->
          <div class="tab-pane fade <%= activeTab === 'bookings' ? 'show active' : '' %>" id="bookings-pane">
            <!-- Filter and Search Bar -->
            <div class="glass-card mb-4 p-3 bg-white shadow-sm">
              <!-- Quick Range Filter Buttons & Date Range Label -->
              <div class="admin-filter-header mb-3 pb-2 border-bottom">
                <!-- Date range label row -->
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                  <span class="badge bg-primary text-white py-2 px-3 admin-date-range-badge">
                    📅 <%= dateRangeLabel %>
                  </span>
                  <span class="badge bg-light text-secondary border py-2 px-2">
                    🌐 <%= timeZone %>
                  </span>
                </div>
                <!-- Quick view buttons — horizontally scrollable on mobile -->
                <div class="admin-quick-views" role="group">
                  <a href="/admin?tab=bookings&view=7days"
                    class="btn btn-sm <%= viewMode === '7days' ? 'btn-dark' : 'btn-outline-secondary' %>">
                    🗓️ Rolling 7 Days
                  </a>
                  <a href="/admin?tab=bookings&view=today"
                    class="btn btn-sm <%= viewMode === 'today' ? 'btn-dark' : 'btn-outline-secondary' %>">
                    ⚡ Today
                  </a>
                  <a href="/admin?tab=bookings&view=upcoming"
                    class="btn btn-sm <%= viewMode === 'upcoming' ? 'btn-dark' : 'btn-outline-secondary' %>">
                    🔜 Upcoming
                  </a>
                  <a href="/admin?tab=bookings&view=all"
                    class="btn btn-sm <%= viewMode === 'all' ? 'btn-dark' : 'btn-outline-secondary' %>">
                    📚 All History
                  </a>
                </div>
              </div>

              <form method="get" action="/admin" class="row g-2 align-items-center">
                <input type="hidden" name="tab" value="bookings">
                <input type="hidden" name="view" value="custom">
                <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                  <label class="form-label small fw-bold text-muted mb-1">Filter by Specific Date</label>
                  <input type="date" name="filterDate" class="form-control form-control-sm"
                    value="<%= filters.filterDate || '' %>">
                </div>
                <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                  <label class="form-label small fw-bold text-muted mb-1">Status</label>
                  <select name="filterStatus" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <% ['pending', 'confirmed' , 'rejected' , 'cancelled' , 'completed' ].forEach(s=> { %>
                      <option value="<%= s %>" <%=filters.filterStatus===s ? 'selected' : '' %>><%= s.toUpperCase() %>
                      </option>
                      <% }) %>
                  </select>
                </div>
                <div class="col-12 col-md-3 col-lg-4">
                  <label class="form-label small fw-bold text-muted mb-1">Search Customer / Phone / Reference</label>
                  <input type="text" name="search" class="form-control form-control-sm"
                    placeholder="Search by name, phone or NL-XXXXXX" value="<%= filters.search || '' %>">
                </div>
                <div class="col-12 col-md-3 col-lg-3 d-flex gap-2 align-self-end mt-2 mt-md-0">
                  <button type="submit" class="btn btn-sm btn-dark flex-fill d-inline-flex align-items-center justify-content-center" style="min-height: 38px;">
                    <span>🔍 Filter</span>
                  </button>
                  <a href="/admin?tab=bookings" id="adminResetFilterBtn" class="btn btn-sm btn-outline-secondary flex-fill d-inline-flex align-items-center justify-content-center text-nowrap" style="min-height: 38px;">
                    <span>🔄 Reset</span>
                  </a>
                </div>
              </form>
            </div>

            <!-- =============================================
                 APPOINTMENTS — DESKTOP TABLE (≥1024px)
                 ============================================= -->
            <div class="glass-card p-0 bg-white overflow-hidden shadow-sm admin-desktop-table">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 680px;">
                  <thead class="table-light small text-uppercase fw-bold">
                    <tr>
                      <th class="ps-3">Reference / Date</th>
                      <th>Customer & Contact</th>
                      <th>Fingernail Service</th>
                      <th>Time Slot</th>
                      <th>Status</th>
                      <th class="text-end pe-3">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="small">
                    <% if (!bookings.length) { %>
                      <tr>
                        <td colspan="6" class="text-center py-5 text-secondary">
                          No nail appointments match the selected filter.
                        </td>
                      </tr>
                    <% } %>
                    <% bookings.forEach(b=> { %>
                      <tr>
                        <td class="ps-3">
                          <strong class="text-primary font-monospace"><%= b.bookingReference %></strong>
                          <div class="text-dark fw-bold"><%= b.date %></div>
                          <small class="badge bg-light text-secondary"><%= b.source.toUpperCase() %></small>
                        </td>
                        <td>
                          <div class="fw-bold text-dark"><%= b.customerName %></div>
                          <div><a href="tel:<%= b.phone %>" class="text-decoration-none text-secondary"><%= b.phone %></a></div>
                          <% if (b.telegramId) { %><small class="text-primary">Telegram ID: <%= b.telegramId %></small><% } %>
                          <% if (b.notes) { %><div class="text-muted small fst-italic">"<%= b.notes %>"</div><% } %>
                        </td>
                        <td>
                          <strong><%= b.service %></strong>
                          <div class="text-muted small"><%= b.serviceKm %></div>
                          <div class="text-danger fw-bold">$<%= b.price %></div>
                        </td>
                        <td>
                          <strong><%= b.time %> - <%= b.endTime %></strong>
                          <div class="text-muted small">(<%= b.durationMinutes %> mins)</div>
                        </td>
                        <td><span class="badge-status badge-<%= b.status %>"><%= b.status %></span></td>
                        <td class="text-end pe-3">
                          <div class="admin-action-btn-group">
                            <% if (b.status==='pending') { %>
                              <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline">
                                <input type="hidden" name="status" value="confirmed">
                                <button type="submit" class="btn btn-sm btn-success px-2 py-1" title="Confirm booking">✓ Confirm</button>
                              </form>
                              <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline">
                                <input type="hidden" name="status" value="rejected">
                                <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" title="Reject booking">✕ Reject</button>
                              </form>
                            <% } else if (b.status==='confirmed') { %>
                              <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline">
                                <input type="hidden" name="status" value="completed">
                                <button type="submit" class="btn btn-sm btn-outline-primary px-2 py-1">Complete</button>
                              </form>
                              <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline" onsubmit="return confirm('Cancel this confirmed appointment?');">
                                <input type="hidden" name="status" value="cancelled">
                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-1">Cancel</button>
                              </form>
                            <% } else { %>
                              <span class="text-muted small fst-italic me-2">Archived</span>
                            <% } %>
                            <button type="button" class="btn btn-sm btn-light border px-2 py-1"
                              data-bs-toggle="modal" data-bs-target="#rescheduleModal"
                              data-id="<%= b._id %>" data-ref="<%= b.bookingReference %>"
                              data-date="<%= b.date %>" data-time="<%= b.time %>"
                              data-duration="<%= b.durationMinutes %>" data-name="<%= b.customerName %>">
                              🗓️ Reschedule
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1"
                              data-bs-toggle="modal" data-bs-target="#deleteBookingModal"
                              data-id="<%= b._id %>" data-ref="<%= b.bookingReference %>"
                              data-name="<%= b.customerName %>" data-service="<%= b.service %>"
                              data-date="<%= b.date %>" data-time="<%= b.time %>">
                              🗑️ Delete
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- =============================================
                 APPOINTMENTS — MOBILE CARDS (<1024px)
                 ============================================= -->
            <div class="admin-mobile-cards">
              <% if (!bookings.length) { %>
                <div class="admin-card-empty">
                  <div class="admin-card-empty-icon">📅</div>
                  <div>No nail appointments match the selected filter.</div>
                </div>
              <% } %>
              <% bookings.forEach(b=> { %>
                <div class="admin-record-card">
                  <!-- Card Header -->
                  <div class="admin-card-header">
                    <div class="admin-card-title">
                      <span class="admin-card-name"><%= b.customerName %></span>
                      <span class="badge-status badge-<%= b.status %>"><%= b.status %></span>
                    </div>
                    <div class="admin-card-ref font-monospace"><%= b.bookingReference %></div>
                  </div>
                  <!-- Card Body -->
                  <div class="admin-card-body">
                    <div class="admin-card-row">
                      <span class="admin-card-label">📅 Date</span>
                      <span class="admin-card-value fw-bold"><%= b.date %></span>
                    </div>
                    <div class="admin-card-row">
                      <span class="admin-card-label">⏰ Time</span>
                      <span class="admin-card-value"><strong><%= b.time %> – <%= b.endTime %></strong> (<%= b.durationMinutes %> mins)</span>
                    </div>
                    <div class="admin-card-row">
                      <span class="admin-card-label">💅 Service</span>
                      <span class="admin-card-value">
                        <strong><%= b.service %></strong>
                        <% if (b.serviceKm) { %><br><span class="text-muted small"><%= b.serviceKm %></span><% } %>
                      </span>
                    </div>
                    <div class="admin-card-row">
                      <span class="admin-card-label">💰 Price</span>
                      <span class="admin-card-value text-danger fw-bold">$<%= b.price %></span>
                    </div>
                    <div class="admin-card-row">
                      <span class="admin-card-label">📞 Phone</span>
                      <span class="admin-card-value"><a href="tel:<%= b.phone %>" class="text-decoration-none"><%= b.phone %></a></span>
                    </div>
                    <% if (b.telegramId) { %>
                    <div class="admin-card-row">
                      <span class="admin-card-label">✈️ Telegram</span>
                      <span class="admin-card-value text-primary small"><%= b.telegramId %></span>
                    </div>
                    <% } %>
                    <div class="admin-card-row">
                      <span class="admin-card-label">📲 Source</span>
                      <span class="admin-card-value"><span class="badge bg-light text-secondary border"><%= b.source.toUpperCase() %></span></span>
                    </div>
                    <% if (b.notes) { %>
                    <div class="admin-card-row admin-card-row--full">
                      <span class="admin-card-label">📝 Notes</span>
                      <span class="admin-card-value fst-italic text-muted">"<%= b.notes %>"</span>
                    </div>
                    <% } %>
                  </div>
                  <!-- Card Actions -->
                  <div class="admin-card-actions">
                    <% if (b.status==='pending') { %>
                      <form method="post" action="/admin/bookings/<%= b._id %>/status">
                        <input type="hidden" name="status" value="confirmed">
                        <button type="submit" class="admin-card-btn admin-card-btn--success">✓ Confirm</button>
                      </form>
                      <form method="post" action="/admin/bookings/<%= b._id %>/status">
                        <input type="hidden" name="status" value="rejected">
                        <button type="submit" class="admin-card-btn admin-card-btn--danger-outline">✕ Reject</button>
                      </form>
                    <% } else if (b.status==='confirmed') { %>
                      <form method="post" action="/admin/bookings/<%= b._id %>/status">
                        <input type="hidden" name="status" value="completed">
                        <button type="submit" class="admin-card-btn admin-card-btn--primary-outline">✅ Complete</button>
                      </form>
                      <form method="post" action="/admin/bookings/<%= b._id %>/status" onsubmit="return confirm('Cancel this confirmed appointment?');">
                        <input type="hidden" name="status" value="cancelled">
                        <button type="submit" class="admin-card-btn admin-card-btn--secondary-outline">Cancel</button>
                      </form>
                    <% } else { %>
                      <span class="text-muted small fst-italic">Archived</span>
                    <% } %>
                    <button type="button" class="admin-card-btn admin-card-btn--light"
                      data-bs-toggle="modal" data-bs-target="#rescheduleModal"
                      data-id="<%= b._id %>" data-ref="<%= b.bookingReference %>"
                      data-date="<%= b.date %>" data-time="<%= b.time %>"
                      data-duration="<%= b.durationMinutes %>" data-name="<%= b.customerName %>">
                      🗓️ Reschedule
                    </button>
                    <button type="button" class="admin-card-btn admin-card-btn--danger-outline"
                      data-bs-toggle="modal" data-bs-target="#deleteBookingModal"
                      data-id="<%= b._id %>" data-ref="<%= b.bookingReference %>"
                      data-name="<%= b.customerName %>" data-service="<%= b.service %>"
                      data-date="<%= b.date %>" data-time="<%= b.time %>">
                      🗑️ Delete
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- TAB: BOOKING CALENDAR -->
          <div class="tab-pane fade <%= activeTab === 'calendar' ? 'show active' : '' %>" id="calendar-pane">
            <!-- Calendar Controls & Filter Toolbar -->
            <div class="glass-card mb-4 p-3 bg-white shadow-sm">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center flex-wrap gap-2">
                  <span class="badge bg-primary text-white fs-6 py-2 px-3">
                    🗓️ Booking Calendar
                  </span>
                  <span class="badge bg-light text-secondary border py-2 px-2">
                    🌐 Asia/Phnom_Penh (UTC+7)
                  </span>
                  <span class="badge bg-dark py-2 px-3" id="calMonthTotalBadge">
                    Loading...
                  </span>
                </div>

                <!-- Quick View / Navigation buttons -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="calPrevBtn" title="Previous Month">
                    ‹ Previous
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-primary fw-bold" id="calTodayBtn"
                    title="Jump to Today in Phnom Penh">
                    ⚡ Today
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-secondary" id="calNextBtn" title="Next Month">
                    Next ›
                  </button>
                  <button type="button" class="btn btn-sm btn-light border" id="calRefreshBtn" title="Refresh calendar">
                    🔄
                  </button>
                </div>
              </div>

              <!-- Filter Form Controls -->
              <div class="row g-2 align-items-end">
                <!-- Month Selector -->
                <div class="col-md-3 col-sm-6">
                  <label class="form-label small fw-bold text-muted mb-1">Select Month / Year</label>
                  <input type="month" id="calMonthPicker" class="form-control form-control-sm"
                    value="<%= today.slice(0, 7) %>">
                </div>

                <!-- Date Type Basis -->
                <div class="col-md-3 col-sm-6">
                  <label class="form-label small fw-bold text-muted mb-1">Filter Basis</label>
                  <select id="calDateType" class="form-select form-select-sm">
                    <option value="appointment" selected>📅 Appointment Date (date)</option>
                    <option value="created">⏱️ Record Created Date (created_at)</option>
                  </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-2 col-sm-6">
                  <label class="form-label small fw-bold text-muted mb-1">Booking Status</label>
                  <select id="calStatusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="pending">PENDING</option>
                    <option value="confirmed">CONFIRMED</option>
                    <option value="completed">COMPLETED</option>
                    <option value="cancelled">CANCELLED</option>
                    <option value="rejected">REJECTED</option>
                  </select>
                </div>

                <!-- Range Filter Toggle & Inputs -->
                <div class="col-md-4 col-sm-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small fw-bold text-muted mb-0">Custom Date Range</label>
                    <div class="form-check form-switch mb-0">
                      <input class="form-check-input" type="checkbox" id="calRangeToggle">
                      <label class="form-check-label small text-muted" for="calRangeToggle">Enable Range</label>
                    </div>
                  </div>
                  <div class="d-flex gap-1" id="calRangeInputsContainer" style="display: none !important;">
                    <input type="date" id="calRangeStart" class="form-control form-control-sm" placeholder="Start">
                    <input type="date" id="calRangeEnd" class="form-control form-control-sm" placeholder="End">
                    <button type="button" id="calRangeApplyBtn" class="btn btn-sm btn-dark px-2">Apply</button>
                  </div>
                  <div id="calRangeHint" class="small text-muted text-truncate">
                    Click any day on calendar to view that day's bookings.
                  </div>
                </div>
              </div>
            </div>

            <!-- 2-Column Calendar & Bookings Details Layout -->
            <div class="row g-3">
              <!-- Left Column: Calendar Grid -->
              <div class="col-lg-7">
                <div class="glass-card p-3 bg-white shadow-sm">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark" id="calMonthTitle">October 2026</h5>
                    <div class="d-flex gap-1" id="calMonthStatusBadges">
                      <!-- Dynamically populated status pills for the month -->
                    </div>
                  </div>

                  <!-- Day-of-week header -->
                  <div class="calendar-grid-header">
                    <div class="weekend">Sun</div>
                    <div>Mon</div>
                    <div>Tue</div>
                    <div>Wed</div>
                    <div>Thu</div>
                    <div>Fri</div>
                    <div class="weekend">Sat</div>
                  </div>

                  <!-- Calendar Day Cells Matrix -->
                  <div class="calendar-grid" id="calGrid">
                    <!-- Dynamically populated cells -->
                  </div>

                  <!-- Legend footer -->
                  <div
                    class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-2 border-top small text-muted">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <span class="fw-bold">Legend:</span>
                      <span class="cal-status-dot cal-dot-pending">🟡 Pending</span>
                      <span class="cal-status-dot cal-dot-confirmed">🟢 Confirmed</span>
                      <span class="cal-status-dot cal-dot-completed">🔵 Completed</span>
                      <span class="cal-status-dot cal-dot-cancelled">⚪ Cancelled</span>
                      <span class="cal-status-dot cal-dot-rejected">🔴 Rejected</span>
                    </div>
                    <div class="fst-italic text-secondary">
                      * Based on Asia/Phnom_Penh timezone
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Column: Selected Date Bookings List -->
              <div class="col-lg-5">
                <div class="glass-card p-3 bg-white shadow-sm position-sticky" style="top: 85px;">
                  <!-- Selected Date Header -->
                  <div class="d-flex justify-content-between align-items-start mb-3 pb-2 border-bottom">
                    <div>
                      <h6 class="fw-bold mb-1 text-dark" id="calSelectedDateHeader">📅 Select a date</h6>
                      <div class="small text-muted" id="calSelectedDateSubtext">Click on any date to inspect
                        appointments</div>
                    </div>
                    <div class="text-end">
                      <span class="badge bg-primary fs-6" id="calSelectedCountBadge">0 Bookings</span>
                    </div>
                  </div>

                  <!-- Loading Indicator -->
                  <div id="calDetailLoading" class="text-center py-5" style="display: none;">
                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                    <span class="ms-2 text-muted small">Loading appointments...</span>
                  </div>

                  <!-- Error Alert -->
                  <div id="calDetailError" class="alert alert-danger small py-2 mb-3" style="display: none;">
                    Failed to load appointments. <button type="button"
                      class="btn btn-sm btn-link p-0 text-danger fw-bold" id="calDetailRetryBtn">Retry</button>
                  </div>

                  <!-- Empty Date Notice -->
                  <div id="calDetailEmpty" class="text-center py-5 text-muted" style="display: none;">
                    <div class="fs-1 mb-2">💅</div>
                    <div class="fw-bold">No bookings for this date</div>
                    <div class="small">គ្មានការកក់ទុកសម្រាប់កាលបរិច្ឆេទនេះទេ</div>
                  </div>

                  <!-- Bookings List Container -->
                  <div id="calBookingsList" class="d-flex flex-column gap-2"
                    style="max-height: 580px; overflow-y: auto; padding-right: 4px;">
                    <!-- Populated via JavaScript -->
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 2: FINGERNAIL SERVICES CRUD -->
          <div class="tab-pane fade <%= activeTab === 'services' ? 'show active' : '' %>" id="services-pane">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
              <div>
                <h4 class="fw-bold mb-0">Fingernail Services Catalog</h4>
                <p class="text-secondary small mb-0">Manage services, prices, durations, active status, and group assignments.</p>
              </div>
              <div class="d-flex flex-wrap align-items-center gap-2">
                <select id="adminGroupFilter" class="form-select form-select-sm" style="max-width: 100%; min-width: 170px;">
                  <option value="all">📁 All Groups (<%= services.length %>)</option>
                  <% (typeof serviceGroups !== 'undefined' && serviceGroups ? serviceGroups : []).forEach(g => { %>
                    <option value="<%= g.id %>">📁 <%= g.name %> (<%= g.servicesCount || 0 %>)</option>
                  <% }) %>
                </select>
                <button type="button" class="btn-nail btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                  + Add Nail Service
                </button>
              </div>
            </div>

            <!-- =============================================
                 SERVICES — DESKTOP TABLE (≥1024px)
                 ============================================= -->
            <div class="glass-card p-0 bg-white overflow-hidden shadow-sm admin-desktop-table">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="adminServicesTable" style="min-width: 720px;">
                  <thead class="table-light small text-uppercase fw-bold">
                    <tr>
                      <th class="ps-3">Service Image & Name</th>
                      <th>Khmer Name</th>
                      <th>Group</th>
                      <th>Price ($)</th>
                      <th>Duration</th>
                      <th>Status</th>
                      <th class="text-end pe-3">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="small">
                    <% services.forEach(s=> {
                         const currentGrp = (typeof serviceGroups !== 'undefined' && serviceGroups ? serviceGroups : []).find(g => String(g.id) === String(s.groupId));
                    %>
                      <tr data-service-group="<%= s.groupId || 'uncategorized' %>">
                        <td class="ps-3">
                          <div class="d-flex align-items-center gap-2">
                            <img src="<%= s.imageUrl || 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=150&q=80' %>" alt="<%= s.name %>" class="rounded-3 border" style="width:44px;height:44px;object-fit:cover;">
                            <div>
                              <strong><%= s.name %></strong>
                              <div class="text-muted small" style="max-width:250px;"><%= s.description %></div>
                            </div>
                          </div>
                        </td>
                        <td>
                          <strong class="text-dark"><%= s.nameKm %></strong>
                          <div class="text-muted small" style="max-width:250px;"><%= s.descriptionKm %></div>
                        </td>
                        <td><span class="badge bg-light text-dark border">📁 <%= currentGrp ? currentGrp.name : 'Uncategorized' %></span></td>
                        <td><span class="text-danger fw-bold fs-6">$<%= s.price %></span></td>
                        <td>⏱️ <%= s.durationMinutes %> mins</td>
                        <td>
                          <% if (s.isActive) { %>
                            <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                          <% } else { %>
                            <span class="badge bg-secondary-subtle text-secondary fw-bold">Inactive</span>
                          <% } %>
                        </td>
                        <td class="text-end pe-3">
                          <div class="admin-action-btn-group">
                            <div class="dropdown d-inline">
                              <button class="btn btn-sm btn-outline-primary py-1 px-2 dropdown-toggle" type="button" data-bs-toggle="dropdown">Move</button>
                              <ul class="dropdown-menu dropdown-menu-end shadow-sm small">
                                <li class="dropdown-header text-muted">Move to Group:</li>
                                <% (typeof serviceGroups !== 'undefined' && serviceGroups ? serviceGroups : []).forEach(g => { %>
                                  <li>
                                    <form method="post" action="/admin/services/<%= s._id %>/move-group">
                                      <input type="hidden" name="groupId" value="<%= g.id %>">
                                      <button type="submit" class="dropdown-item small <%= String(s.groupId) === String(g.id) ? 'active' : '' %>">📁 <%= g.name %> (<%= g.nameKm %>)</button>
                                    </form>
                                  </li>
                                <% }) %>
                              </ul>
                            </div>
                            <form method="post" action="/admin/services/<%= s._id %>/toggle" class="d-inline">
                              <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2"><%= s.isActive ? 'Deactivate' : 'Activate' %></button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2"
                              data-bs-toggle="modal" data-bs-target="#editServiceModal"
                              data-id="<%= s._id %>" data-name="<%= s.name %>" data-namekm="<%= s.nameKm %>"
                              data-price="<%= s.price %>" data-duration="<%= s.durationMinutes %>"
                              data-desc="<%= s.description %>" data-desckm="<%= s.descriptionKm %>"
                              data-image="<%= s.imageUrl %>" data-groupid="<%= s.groupId || '' %>">
                              Edit
                            </button>
                            <form method="post" action="/admin/services/<%= s._id %>/delete" class="d-inline" onsubmit="return confirm('Delete this fingernail service?');">
                              <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2">Delete</button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- =============================================
                 SERVICES — MOBILE CARDS (<1024px)
                 ============================================= -->
            <div class="admin-mobile-cards" id="adminServicesCards">
              <% services.forEach(s=> {
                   const currentGrp = (typeof serviceGroups !== 'undefined' && serviceGroups ? serviceGroups : []).find(g => String(g.id) === String(s.groupId));
              %>
                <div class="admin-record-card" data-service-group="<%= s.groupId || 'uncategorized' %>">
                  <!-- Card Header -->
                  <div class="admin-card-header">
                    <div class="d-flex align-items-center gap-2">
                      <img src="<%= s.imageUrl || 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=150&q=80' %>" alt="<%= s.name %>" class="admin-card-service-img">
                      <div>
                        <div class="admin-card-name"><%= s.name %></div>
                        <div class="text-muted small"><%= s.nameKm %></div>
                      </div>
                    </div>
                    <% if (s.isActive) { %>
                      <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary fw-bold">Inactive</span>
                    <% } %>
                  </div>
                  <!-- Card Body -->
                  <div class="admin-card-body">
                    <div class="admin-card-row">
                      <span class="admin-card-label">📁 Group</span>
                      <span class="admin-card-value"><span class="badge bg-light text-dark border">📁 <%= currentGrp ? currentGrp.name : 'Uncategorized' %></span></span>
                    </div>
                    <div class="admin-card-row">
                      <span class="admin-card-label">💰 Price</span>
                      <span class="admin-card-value text-danger fw-bold">$<%= s.price %></span>
                    </div>
                    <div class="admin-card-row">
                      <span class="admin-card-label">⏱️ Duration</span>
                      <span class="admin-card-value"><%= s.durationMinutes %> mins</span>
                    </div>
                    <% if (s.description) { %>
                    <div class="admin-card-row admin-card-row--full">
                      <span class="admin-card-label">📝 Description (EN)</span>
                      <span class="admin-card-value text-muted small"><%= s.description %></span>
                    </div>
                    <% } %>
                    <% if (s.descriptionKm) { %>
                    <div class="admin-card-row admin-card-row--full">
                      <span class="admin-card-label">📝 ពិពណ៌នា (KM)</span>
                      <span class="admin-card-value text-muted small"><%= s.descriptionKm %></span>
                    </div>
                    <% } %>
                  </div>
                  <!-- Card Actions -->
                  <div class="admin-card-actions">
                    <div class="dropdown">
                      <button class="admin-card-btn admin-card-btn--primary-outline dropdown-toggle" type="button" data-bs-toggle="dropdown">📁 Move Group</button>
                      <ul class="dropdown-menu shadow-sm small">
                        <li class="dropdown-header text-muted">Move to Group:</li>
                        <% (typeof serviceGroups !== 'undefined' && serviceGroups ? serviceGroups : []).forEach(g => { %>
                          <li>
                            <form method="post" action="/admin/services/<%= s._id %>/move-group">
                              <input type="hidden" name="groupId" value="<%= g.id %>">
                              <button type="submit" class="dropdown-item small <%= String(s.groupId) === String(g.id) ? 'active' : '' %>">📁 <%= g.name %></button>
                            </form>
                          </li>
                        <% }) %>
                      </ul>
                    </div>
                    <form method="post" action="/admin/services/<%= s._id %>/toggle">
                      <button type="submit" class="admin-card-btn admin-card-btn--secondary-outline">
                        <%= s.isActive ? '🔴 Deactivate' : '🟢 Activate' %>
                      </button>
                    </form>
                    <button type="button" class="admin-card-btn admin-card-btn--dark-outline"
                      data-bs-toggle="modal" data-bs-target="#editServiceModal"
                      data-id="<%= s._id %>" data-name="<%= s.name %>" data-namekm="<%= s.nameKm %>"
                      data-price="<%= s.price %>" data-duration="<%= s.durationMinutes %>"
                      data-desc="<%= s.description %>" data-desckm="<%= s.descriptionKm %>"
                      data-image="<%= s.imageUrl %>" data-groupid="<%= s.groupId || '' %>">
                      ✏️ Edit
                    </button>
                    <form method="post" action="/admin/services/<%= s._id %>/delete" onsubmit="return confirm('Delete this fingernail service?');">
                      <button type="submit" class="admin-card-btn admin-card-btn--danger-outline">🗑️ Delete</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- TAB: SERVICE GROUPS MANAGEMENT -->
          <div class="tab-pane fade <%= activeTab === 'groups' ? 'show active' : '' %>" id="groups-pane">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h4 class="fw-bold mb-0">Fingernail Service Groups Management</h4>
                <p class="text-secondary small mb-0">Create, edit, reorder, activate or deactivate service groups synchronized across Customer Web, Telegram Bot, and Admin.</p>
              </div>
              <button type="button" class="btn-nail btn-sm" data-bs-toggle="modal" data-bs-target="#addGroupModal">
                + Create New Group
              </button>
            </div>

            <!-- =============================================
                 SERVICE GROUPS — DESKTOP TABLE (≥1024px)
                 ============================================= -->
            <div class="glass-card p-0 bg-white overflow-hidden shadow-sm admin-desktop-table">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 580px;">
                  <thead class="table-light small text-uppercase fw-bold">
                    <tr>
                      <th class="ps-3" style="width:70px;">Order</th>
                      <th>Group Name (English)</th>
                      <th>Khmer Name</th>
                      <th>Description</th>
                      <th>Assigned Services</th>
                      <th>Status</th>
                      <th class="text-end pe-3">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="small">
                    <% (typeof serviceGroups !== 'undefined' && serviceGroups ? serviceGroups : []).forEach(g => { %>
                      <tr>
                        <td class="ps-3 fw-bold text-muted">#<%= g.displayOrder %></td>
                        <td><strong>📁 <%= g.name %></strong></td>
                        <td><strong class="text-dark"><%= g.nameKm %></strong></td>
                        <td><div class="text-muted small" style="max-width:280px;"><%= g.description || '-' %></div></td>
                        <td>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                            <%= g.servicesCount || 0 %> <%= (g.servicesCount === 1) ? 'service' : 'services' %>
                          </span>
                        </td>
                        <td>
                          <% if (g.isActive) { %>
                            <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                          <% } else { %>
                            <span class="badge bg-secondary-subtle text-secondary fw-bold">Inactive</span>
                          <% } %>
                        </td>
                        <td class="text-end pe-3">
                          <div class="admin-action-btn-group">
                            <form method="post" action="/admin/service-groups/<%= g.id %>/toggle" class="d-inline">
                              <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2"><%= g.isActive ? 'Deactivate' : 'Activate' %></button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2 edit-group-btn"
                              data-bs-toggle="modal" data-bs-target="#editGroupModal"
                              data-id="<%= g.id %>" data-name="<%= g.name %>" data-namekm="<%= g.nameKm %>"
                              data-desc="<%= g.description %>" data-desckm="<%= g.descriptionKm %>"
                              data-order="<%= g.displayOrder %>">
                              Edit
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- =============================================
                 SERVICE GROUPS — MOBILE CARDS (<1024px)
                 ============================================= -->
            <div class="admin-mobile-cards">
              <% (typeof serviceGroups !== 'undefined' && serviceGroups ? serviceGroups : []).forEach(g => { %>
                <div class="admin-record-card">
                  <!-- Card Header -->
                  <div class="admin-card-header">
                    <div>
                      <div class="admin-card-name">📁 <%= g.name %></div>
                      <div class="text-muted small"><%= g.nameKm %></div>
                    </div>
                    <% if (g.isActive) { %>
                      <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary fw-bold">Inactive</span>
                    <% } %>
                  </div>
                  <!-- Card Body -->
                  <div class="admin-card-body">
                    <div class="admin-card-row">
                      <span class="admin-card-label">🔢 Display Order</span>
                      <span class="admin-card-value fw-bold">#<%= g.displayOrder %></span>
                    </div>
                    <div class="admin-card-row">
                      <span class="admin-card-label">💅 Services</span>
                      <span class="admin-card-value">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                          <%= g.servicesCount || 0 %> <%= (g.servicesCount === 1) ? 'service' : 'services' %>
                        </span>
                      </span>
                    </div>
                    <% if (g.description) { %>
                    <div class="admin-card-row admin-card-row--full">
                      <span class="admin-card-label">📝 Description</span>
                      <span class="admin-card-value text-muted small"><%= g.description %></span>
                    </div>
                    <% } %>
                    <% if (g.descriptionKm) { %>
                    <div class="admin-card-row admin-card-row--full">
                      <span class="admin-card-label">📝 ពិពណ៌នា</span>
                      <span class="admin-card-value text-muted small"><%= g.descriptionKm %></span>
                    </div>
                    <% } %>
                  </div>
                  <!-- Card Actions -->
                  <div class="admin-card-actions">
                    <form method="post" action="/admin/service-groups/<%= g.id %>/toggle">
                      <button type="submit" class="admin-card-btn admin-card-btn--secondary-outline">
                        <%= g.isActive ? '🔴 Deactivate' : '🟢 Activate' %>
                      </button>
                    </form>
                    <button type="button" class="admin-card-btn admin-card-btn--dark-outline edit-group-btn"
                      data-bs-toggle="modal" data-bs-target="#editGroupModal"
                      data-id="<%= g.id %>" data-name="<%= g.name %>" data-namekm="<%= g.nameKm %>"
                      data-desc="<%= g.description %>" data-desckm="<%= g.descriptionKm %>"
                      data-order="<%= g.displayOrder %>">
                      ✏️ Edit Group
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- TAB 3: SALON SCHEDULE & HOURS -->
          <div class="tab-pane fade <%= activeTab === 'schedule' ? 'show active' : '' %>" id="schedule-pane">
            <div class="row g-4">
              <div class="col-lg-7">
                <div class="glass-card bg-white p-4">
                  <h4 class="fw-bold mb-3">Operating Hours & Capacity</h4>
                  <form method="post" action="/admin/settings">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Salon Name</label>
                        <input type="text" name="salonName" class="form-control" value="<%= settings.salonName %>"
                          required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Salon Contact Phone</label>
                        <input type="text" name="salonPhone" class="form-control" value="<%= settings.salonPhone %>"
                          required>
                      </div>

                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Opening Time (24h)</label>
                        <input type="time" name="openingTime" class="form-control" value="<%= settings.openingTime %>"
                          required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Closing Time (24h)</label>
                        <input type="time" name="closingTime" class="form-control" value="<%= settings.closingTime %>"
                          required>
                      </div>

                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Break Start Time</label>
                        <input type="time" name="breakStart" class="form-control" value="<%= settings.breakStart %>">
                      </div>
                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Break End Time</label>
                        <input type="time" name="breakEnd" class="form-control" value="<%= settings.breakEnd %>">
                      </div>

                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Booking Slot Interval (Minutes)</label>
                        <select name="slotIntervalMinutes" class="form-select">
                          <% [15, 20, 30, 45, 60].forEach(m=> { %>
                            <option value="<%= m %>" <%=settings.slotIntervalMinutes===m ? 'selected' : '' %>><%= m %>
                                minutes</option>
                            <% }) %>
                        </select>
                      </div>

                      <div class="col-md-6">
                        <label class="form-label fw-bold small">Max Concurrent Stations / Staff</label>
                        <input type="number" name="maxConcurrentStaff" class="form-control" min="1" max="20"
                          value="<%= settings.maxConcurrentStaff %>" required>
                        <small class="text-muted">Simultaneous clients that can be served at the same time.</small>
                      </div>

                      <div class="col-12">
                        <label class="form-label fw-bold small d-block">Working Days</label>
                        <div class="d-flex flex-wrap gap-3">
                          <% const days=[ { d: 1, label: 'Mon' }, { d: 2, label: 'Tue' }, { d: 3, label: 'Wed' }, { d:
                            4, label: 'Thu' }, { d: 5, label: 'Fri' }, { d: 6, label: 'Sat' }, { d: 0, label: 'Sun' } ];
                            %>
                            <% days.forEach(day=> { %>
                              <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="<%= day.d %>"
                                  id="day_<%= day.d %>" <%=settings.workingDays.includes(day.d) ? 'checked' : '' %>>
                                <label class="form-check-label small fw-bold" for="day_<%= day.d %>">
                                  <%= day.label %>
                                </label>
                              </div>
                              <% }) %>
                        </div>
                      </div>

                      <div class="col-12 mt-4">
                        <button type="submit" class="btn-nail">💾 Save Schedule Settings</button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>

              <div class="col-lg-5">
                <div class="glass-card bg-white p-4">
                  <h5 class="fw-bold mb-3">Salon Days Off & Holidays</h5>
                  <p class="text-secondary small">Clients will not be allowed to book on dates added to this list.</p>

                  <!-- Add Day Off Form -->
                  <form method="post" action="/admin/daysoff/add" class="d-flex flex-column flex-sm-row gap-2 mb-3">
                    <input type="date" name="dayOffDate" class="form-control form-control-sm" required
                      min="<%= today %>">
                    <button type="submit" class="btn btn-sm btn-dark text-nowrap py-2" style="min-height: 38px;">+ Add Day Off</button>
                  </form>

                  <!-- Days Off List -->
                  <ul class="list-group list-group-flush border rounded-3 overflow-hidden">
                    <% if (!settings.daysOff || settings.daysOff.length===0) { %>
                      <li class="list-group-item text-muted small text-center py-3">No custom days off scheduled.</li>
                      <% } %>
                        <% (settings.daysOff || []).sort().forEach(d=> { %>
                          <li class="list-group-item d-flex justify-content-between align-items-center small">
                            <span>🗓️ <strong>
                                <%= d %>
                              </strong></span>
                            <form method="post" action="/admin/daysoff/remove" class="d-inline">
                              <input type="hidden" name="dayOffDate" value="<%= d %>">
                              <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Remove</button>
                            </form>
                          </li>
                          <% }) %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
