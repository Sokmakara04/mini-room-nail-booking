<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard | <%= salonName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    .nav-tabs .nav-link {
      font-weight: 700;
      color: var(--text-muted);
      border: none;
      padding: 0.8rem 1.4rem;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
    .nav-tabs .nav-link.active {
      color: var(--primary);
      background: #ffffff;
      border-bottom: 3px solid var(--primary);
    }
  </style>
</head>
<body style="background: #f8f3f4;">
  <!-- Admin Navbar -->
  <nav class="salon-nav bg-white">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        <a class="salon-brand" href="/admin">
          💅 <%= salonName %> <span class="badge bg-dark fs-6 ms-2">Admin Panel</span>
        </a>
      </div>
      <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-dark btn-sm" target="_blank">🌐 View Website</a>
        <a href="https://t.me/miniroomnail_bot" class="btn btn-sm btn-outline-primary" target="_blank">✈️ Bot Chat</a>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <!-- Top Statistics Grid -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">TODAY'S BOOKINGS</div>
        <div class="admin-stat-val text-primary"><%= stats.todayCount %></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">PENDING CONFIRMATION</div>
        <div class="admin-stat-val text-warning"><%= stats.pendingCount %></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">CONFIRMED APPOINTMENTS</div>
        <div class="admin-stat-val text-success"><%= stats.confirmedCount %></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-lbl">TOTAL ALL TIME</div>
        <div class="admin-stat-val text-dark"><%= stats.totalCount %></div>
      </div>
    </div>

    <!-- Flash message alert -->
    <% if (typeof alertMessage !== 'undefined' && alertMessage) { %>
      <div class="alert alert-<%= alertType || 'info' %> alert-dismissible fade show" role="alert">
        <%= alertMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist">
      <li class="nav-item">
        <button class="nav-link <%= activeTab === 'bookings' ? 'active' : '' %>" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-pane" type="button">
          📅 Appointments (<%= bookings.length %>)
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link <%= activeTab === 'services' ? 'active' : '' %>" id="services-tab" data-bs-toggle="tab" data-bs-target="#services-pane" type="button">
          💅 Fingernail Services (<%= services.length %>)
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link <%= activeTab === 'schedule' ? 'active' : '' %>" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule-pane" type="button">
          ⚙️ Salon Schedule & Hours
        </button>
      </li>
    </ul>

    <div class="tab-content" id="adminTabsContent">
      <!-- TAB 1: APPOINTMENTS -->
      <div class="tab-pane fade <%= activeTab === 'bookings' ? 'show active' : '' %>" id="bookings-pane">
        <!-- Filter and Search Bar -->
        <div class="glass-card mb-4 p-3 bg-white shadow-sm">
          <!-- Quick Range Filter Buttons & Date Range Label -->
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
            <div class="d-flex align-items-center flex-wrap gap-2">
              <span class="badge bg-primary text-white fs-6 py-2 px-3">
                📅 <%= dateRangeLabel %>
              </span>
              <span class="badge bg-light text-secondary border py-2 px-2">
                🌐 <%= timeZone %>
              </span>
            </div>
            <div class="btn-group btn-group-sm" role="group">
              <a href="/admin?tab=bookings&view=7days" class="btn <%= viewMode === '7days' ? 'btn-dark' : 'btn-outline-secondary' %>">
                🗓️ Rolling 7 Days (Default)
              </a>
              <a href="/admin?tab=bookings&view=today" class="btn <%= viewMode === 'today' ? 'btn-dark' : 'btn-outline-secondary' %>">
                ⚡ Today
              </a>
              <a href="/admin?tab=bookings&view=upcoming" class="btn <%= viewMode === 'upcoming' ? 'btn-dark' : 'btn-outline-secondary' %>">
                🔜 All Upcoming
              </a>
              <a href="/admin?tab=bookings&view=all" class="btn <%= viewMode === 'all' ? 'btn-dark' : 'btn-outline-secondary' %>">
                📚 All History
              </a>
            </div>
          </div>

          <form method="get" action="/admin" class="row g-2 align-items-center">
            <input type="hidden" name="tab" value="bookings">
            <input type="hidden" name="view" value="custom">
            <div class="col-md-3">
              <label class="form-label small fw-bold text-muted mb-1">Filter by Specific Date</label>
              <input type="date" name="filterDate" class="form-control form-control-sm" value="<%= filters.filterDate || '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-bold text-muted mb-1">Status</label>
              <select name="filterStatus" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <% ['pending', 'confirmed', 'rejected', 'cancelled', 'completed'].forEach(s => { %>
                  <option value="<%= s %>" <%= filters.filterStatus === s ? 'selected' : '' %>><%= s.toUpperCase() %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold text-muted mb-1">Search Customer / Phone / Reference</label>
              <input type="text" name="search" class="form-control form-control-sm" placeholder="Search by name, phone or NL-XXXXXX" value="<%= filters.search || '' %>">
            </div>
            <div class="col-md-2 d-flex gap-2 align-self-end">
              <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
              <a href="/admin?tab=bookings" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
          </form>
        </div>

        <!-- Appointments Table -->
        <div class="glass-card p-0 bg-white overflow-hidden shadow-sm">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small text-uppercase fw-bold">
                <tr>
                  <th class="ps-3">Reference / Date</th>
                  <th>Customer & Contact</th>
                  <th>Fingernail Service</th>
                  <th>Time Slot</th>
                  <th>Status</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody class="small">
                <% if (!bookings.length) { %>
                  <tr>
                    <td colspan="6" class="text-center py-5 text-secondary">
                      No nail appointments match the selected filter.
                    </td>
                  </tr>
                <% } %>
                <% bookings.forEach(b => { %>
                  <tr>
                    <td class="ps-3">
                      <strong class="text-primary font-monospace"><%= b.bookingReference %></strong>
                      <div class="text-dark fw-bold"><%= b.date %></div>
                      <small class="badge bg-light text-secondary"><%= b.source.toUpperCase() %></small>
                    </td>
                    <td>
                      <div class="fw-bold text-dark"><%= b.customerName %></div>
                      <div><a href="tel:<%= b.phone %>" class="text-decoration-none text-secondary"><%= b.phone %></a></div>
                      <% if (b.telegramId) { %>
                        <small class="text-primary">Telegram ID: <%= b.telegramId %></small>
                      <% } %>
                      <% if (b.notes) { %>
                        <div class="text-muted small fst-italic">"<%= b.notes %>"</div>
                      <% } %>
                    </td>
                    <td>
                      <strong><%= b.service %></strong>
                      <div class="text-muted small"><%= b.serviceKm %></div>
                      <div class="text-danger fw-bold">$<%= b.price %></div>
                    </td>
                    <td>
                      <strong><%= b.time %> - <%= b.endTime %></strong>
                      <div class="text-muted small">(<%= b.durationMinutes %> mins)</div>
                    </td>
                    <td>
                      <span class="badge-status badge-<%= b.status %>"><%= b.status %></span>
                    </td>
                    <td class="text-end pe-3">
                      <div class="d-inline-flex gap-1">
                        <% if (b.status === 'pending') { %>
                          <!-- Quick Confirm -->
                          <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline">
                            <input type="hidden" name="status" value="confirmed">
                            <button type="submit" class="btn btn-sm btn-success px-2 py-1" title="Confirm booking">✓ Confirm</button>
                          </form>
                          <!-- Quick Reject -->
                          <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline">
                            <input type="hidden" name="status" value="rejected">
                            <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" title="Reject booking">✕ Reject</button>
                          </form>
                        <% } else if (b.status === 'confirmed') { %>
                          <!-- Mark Completed -->
                          <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline">
                            <input type="hidden" name="status" value="completed">
                            <button type="submit" class="btn btn-sm btn-outline-primary px-2 py-1" title="Complete appointment">Complete</button>
                          </form>
                          <!-- Cancel -->
                          <form method="post" action="/admin/bookings/<%= b._id %>/status" class="d-inline" onsubmit="return confirm('Cancel this confirmed appointment?');">
                            <input type="hidden" name="status" value="cancelled">
                            <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-1">Cancel</button>
                          </form>
                        <% } else { %>
                          <span class="text-muted small fst-italic me-2">Archived</span>
                        <% } %>

                        <!-- Reschedule Button (opens modal) -->
                        <button type="button" class="btn btn-sm btn-light border px-2 py-1" 
                          data-bs-toggle="modal" 
                          data-bs-target="#rescheduleModal"
                          data-id="<%= b._id %>"
                          data-ref="<%= b.bookingReference %>"
                          data-date="<%= b.date %>"
                          data-time="<%= b.time %>"
                          data-duration="<%= b.durationMinutes %>"
                          data-name="<%= b.customerName %>">
                          🗓️ Reschedule
                        </button>

                        <!-- Delete Button (opens confirmation modal) -->
                        <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1"
                          data-bs-toggle="modal"
                          data-bs-target="#deleteBookingModal"
                          data-id="<%= b._id %>"
                          data-ref="<%= b.bookingReference %>"
                          data-name="<%= b.customerName %>"
                          data-service="<%= b.service %>"
                          data-date="<%= b.date %>"
                          data-time="<%= b.time %>"
                          title="Delete this booking record">
                          🗑️ Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 2: FINGERNAIL SERVICES CRUD -->
      <div class="tab-pane fade <%= activeTab === 'services' ? 'show active' : '' %>" id="services-pane">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h4 class="fw-bold mb-0">Fingernail Services Catalog</h4>
            <p class="text-secondary small mb-0">Manage services, prices, durations, and active status.</p>
          </div>
          <button type="button" class="btn-nail btn-sm" data-bs-toggle="modal" data-bs-target="#addServiceModal">
            + Add Nail Service
          </button>
        </div>

        <div class="glass-card p-0 bg-white overflow-hidden shadow-sm">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small text-uppercase fw-bold">
                <tr>
                  <th class="ps-3">Service Image & Name</th>
                  <th>Khmer Name</th>
                  <th>Price ($)</th>
                  <th>Duration</th>
                  <th>Status</th>
                  <th class="text-end pe-3">Actions</th>
                </tr>
              </thead>
              <tbody class="small">
                <% services.forEach(s => { %>
                  <tr>
                    <td class="ps-3">
                      <div class="d-flex align-items-center gap-2">
                        <img src="<%= s.imageUrl || 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=150&q=80' %>" 
                             alt="<%= s.name %>" class="rounded-3 border" style="width: 44px; height: 44px; object-fit: cover;">
                        <div>
                          <strong><%= s.name %></strong>
                          <div class="text-muted small" style="max-width: 250px;"><%= s.description %></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <strong class="text-dark"><%= s.nameKm %></strong>
                      <div class="text-muted small" style="max-width: 250px;"><%= s.descriptionKm %></div>
                    </td>
                    <td>
                      <span class="text-danger fw-bold fs-6">$<%= s.price %></span>
                    </td>
                    <td>
                      ⏱️ <%= s.durationMinutes %> mins
                    </td>
                    <td>
                      <% if (s.isActive) { %>
                        <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary fw-bold">Inactive</span>
                      <% } %>
                    </td>
                    <td class="text-end pe-3">
                      <!-- Toggle Active -->
                      <form method="post" action="/admin/services/<%= s._id %>/toggle" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Toggle active status">
                          <%= s.isActive ? 'Deactivate' : 'Activate' %>
                        </button>
                      </form>

                      <!-- Edit Button (Modal) -->
                      <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2 ms-1"
                        data-bs-toggle="modal"
                        data-bs-target="#editServiceModal"
                        data-id="<%= s._id %>"
                        data-name="<%= s.name %>"
                        data-namekm="<%= s.nameKm %>"
                        data-price="<%= s.price %>"
                        data-duration="<%= s.durationMinutes %>"
                        data-desc="<%= s.description %>"
                        data-desckm="<%= s.descriptionKm %>"
                        data-image="<%= s.imageUrl %>">
                        Edit
                      </button>

                      <!-- Delete Service -->
                      <form method="post" action="/admin/services/<%= s._id %>/delete" class="d-inline ms-1" onsubmit="return confirm('Delete this fingernail service?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 3: SALON SCHEDULE & HOURS -->
      <div class="tab-pane fade <%= activeTab === 'schedule' ? 'show active' : '' %>" id="schedule-pane">
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="glass-card bg-white p-4">
              <h4 class="fw-bold mb-3">Operating Hours & Capacity</h4>
              <form method="post" action="/admin/settings">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Salon Name</label>
                    <input type="text" name="salonName" class="form-control" value="<%= settings.salonName %>" required>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Salon Contact Phone</label>
                    <input type="text" name="salonPhone" class="form-control" value="<%= settings.salonPhone %>" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Opening Time (24h)</label>
                    <input type="time" name="openingTime" class="form-control" value="<%= settings.openingTime %>" required>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Closing Time (24h)</label>
                    <input type="time" name="closingTime" class="form-control" value="<%= settings.closingTime %>" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Break Start Time</label>
                    <input type="time" name="breakStart" class="form-control" value="<%= settings.breakStart %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Break End Time</label>
                    <input type="time" name="breakEnd" class="form-control" value="<%= settings.breakEnd %>">
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Booking Slot Interval (Minutes)</label>
                    <select name="slotIntervalMinutes" class="form-select">
                      <% [15, 20, 30, 45, 60].forEach(m => { %>
                        <option value="<%= m %>" <%= settings.slotIntervalMinutes === m ? 'selected' : '' %>><%= m %> minutes</option>
                      <% }) %>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold small">Max Concurrent Stations / Staff</label>
                    <input type="number" name="maxConcurrentStaff" class="form-control" min="1" max="20" value="<%= settings.maxConcurrentStaff %>" required>
                    <small class="text-muted">Simultaneous clients that can be served at the same time.</small>
                  </div>

                  <div class="col-12">
                    <label class="form-label fw-bold small d-block">Working Days</label>
                    <div class="d-flex flex-wrap gap-3">
                      <% const days = [
                        { d: 1, label: 'Mon' },
                        { d: 2, label: 'Tue' },
                        { d: 3, label: 'Wed' },
                        { d: 4, label: 'Thu' },
                        { d: 5, label: 'Fri' },
                        { d: 6, label: 'Sat' },
                        { d: 0, label: 'Sun' }
                      ]; %>
                      <% days.forEach(day => { %>
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" name="workingDays" value="<%= day.d %>" id="day_<%= day.d %>" 
                            <%= settings.workingDays.includes(day.d) ? 'checked' : '' %>>
                          <label class="form-check-label small fw-bold" for="day_<%= day.d %>"><%= day.label %></label>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                  <div class="col-12 mt-4">
                    <button type="submit" class="btn-nail">💾 Save Schedule Settings</button>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <div class="col-lg-5">
            <div class="glass-card bg-white p-4">
              <h5 class="fw-bold mb-3">Salon Days Off & Holidays</h5>
              <p class="text-secondary small">Clients will not be allowed to book on dates added to this list.</p>

              <!-- Add Day Off Form -->
              <form method="post" action="/admin/daysoff/add" class="d-flex gap-2 mb-3">
                <input type="date" name="dayOffDate" class="form-control form-control-sm" required min="<%= today %>">
                <button type="submit" class="btn btn-sm btn-dark text-nowrap">+ Add Day Off</button>
              </form>

              <!-- Days Off List -->
              <ul class="list-group list-group-flush border rounded-3 overflow-hidden">
                <% if (!settings.daysOff || settings.daysOff.length === 0) { %>
                  <li class="list-group-item text-muted small text-center py-3">No custom days off scheduled.</li>
                <% } %>
                <% (settings.daysOff || []).sort().forEach(d => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center small">
                    <span>🗓️ <strong><%= d %></strong></span>
                    <form method="post" action="/admin/daysoff/remove" class="d-inline">
                      <input type="hidden" name="dayOffDate" value="<%= d %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">Remove</button>
                    </form>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- MODAL: ADD FINGERNAIL SERVICE -->
  <div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="post" action="/admin/services">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">💅 Add New Fingernail Service</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body row g-3">
            <div class="col-12">
              <label class="form-label small fw-bold">Service Name (English)</label>
              <input type="text" name="name" class="form-control" placeholder="e.g. Chrome Nail Art Design" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Service Name (Khmer)</label>
              <input type="text" name="nameKm" class="form-control" placeholder="e.g. គូរម៉ូដក្រចកបែប Chrome" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold">Price (USD)</label>
              <input type="number" name="price" class="form-control" min="0" step="0.5" placeholder="e.g. 25" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold">Duration (Minutes)</label>
              <input type="number" name="durationMinutes" class="form-control" min="10" step="5" value="45" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Description (English)</label>
              <textarea name="description" class="form-control" rows="2" placeholder="Brief service details..."></textarea>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Description (Khmer)</label>
              <textarea name="descriptionKm" class="form-control" rows="2" placeholder="ព័ត៌មានលម្អិតពីសេវាកម្មជាភាសាខ្មែរ..."></textarea>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Image URL (Optional)</label>
              <input type="url" name="imageUrl" class="form-control" placeholder="https://example.com/nails.jpg">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-nail btn-sm">Add Service</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL: EDIT FINGERNAIL SERVICE -->
  <div class="modal fade" id="editServiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="editServiceForm" method="post" action="">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">✏️ Edit Fingernail Service</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body row g-3">
            <div class="col-12">
              <label class="form-label small fw-bold">Service Name (English)</label>
              <input type="text" id="editServiceName" name="name" class="form-control" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Service Name (Khmer)</label>
              <input type="text" id="editServiceNameKm" name="nameKm" class="form-control" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold">Price (USD)</label>
              <input type="number" id="editServicePrice" name="price" class="form-control" min="0" step="0.5" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold">Duration (Minutes)</label>
              <input type="number" id="editServiceDuration" name="durationMinutes" class="form-control" min="10" step="5" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Description (English)</label>
              <textarea id="editServiceDesc" name="description" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Description (Khmer)</label>
              <textarea id="editServiceDescKm" name="descriptionKm" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Image URL</label>
              <input type="url" id="editServiceImage" name="imageUrl" class="form-control">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-nail btn-sm">Update Service</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL: RESCHEDULE APPOINTMENT -->
  <div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="rescheduleForm" method="post" action="">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">🗓️ Reschedule Appointment</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body row g-3">
            <div class="col-12">
              <div class="alert alert-light border small mb-0">
                Rescheduling for: <strong id="rescheduleCustomer"></strong> (<span id="rescheduleRef" class="text-primary font-monospace"></span>)
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">New Date</label>
              <input type="date" id="rescheduleDate" name="date" class="form-control" required min="<%= today %>">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">New Start Time (HH:mm)</label>
              <input type="text" id="rescheduleTime" name="time" class="form-control" placeholder="14:00" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold">Reason / Admin Note (Optional)</label>
              <input type="text" name="adminNotes" class="form-control" placeholder="Client requested time change...">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-nail btn-sm">Save & Reschedule</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL: DELETE BOOKING CONFIRMATION -->
  <div class="modal fade" id="deleteBookingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content shadow">
        <form id="deleteBookingForm" method="post" action="">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold">⚠️ Confirm Booking Deletion</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p class="text-dark mb-2">Are you sure you want to permanently delete this customer appointment?</p>
            <div class="alert alert-light border small mb-3">
              <div class="mb-1"><strong>Reference:</strong> <span id="delBookingRef" class="text-primary font-monospace fw-bold"></span></div>
              <div class="mb-1"><strong>Customer:</strong> <span id="delBookingCustomer" class="fw-bold"></span></div>
              <div class="mb-1"><strong>Service:</strong> <span id="delBookingService"></span></div>
              <div><strong>Appointment:</strong> <span id="delBookingSchedule"></span></div>
            </div>
            <div class="text-danger small fw-bold">
              ⚠️ Warning: This action cannot be undone. Only this selected appointment record will be removed.
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger btn-sm">Yes, Permanently Delete</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Edit Service Modal Population
    const editServiceModal = document.getElementById('editServiceModal');
    if (editServiceModal) {
      editServiceModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        document.getElementById('editServiceForm').action = `/admin/services/${id}/update`;
        document.getElementById('editServiceName').value = button.getAttribute('data-name') || '';
        document.getElementById('editServiceNameKm').value = button.getAttribute('data-namekm') || '';
        document.getElementById('editServicePrice').value = button.getAttribute('data-price') || '';
        document.getElementById('editServiceDuration').value = button.getAttribute('data-duration') || '45';
        document.getElementById('editServiceDesc').value = button.getAttribute('data-desc') || '';
        document.getElementById('editServiceDescKm').value = button.getAttribute('data-desckm') || '';
        document.getElementById('editServiceImage').value = button.getAttribute('data-image') || '';
      });
    }

    // Reschedule Modal Population
    const rescheduleModal = document.getElementById('rescheduleModal');
    if (rescheduleModal) {
      rescheduleModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        document.getElementById('rescheduleForm').action = `/admin/bookings/${id}/reschedule`;
        document.getElementById('rescheduleCustomer').innerText = button.getAttribute('data-name');
        document.getElementById('rescheduleRef').innerText = button.getAttribute('data-ref');
        document.getElementById('rescheduleDate').value = button.getAttribute('data-date');
        document.getElementById('rescheduleTime').value = button.getAttribute('data-time');
      });
    }

    // Delete Booking Modal Population
    const deleteBookingModal = document.getElementById('deleteBookingModal');
    if (deleteBookingModal) {
      deleteBookingModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        document.getElementById('deleteBookingForm').action = `/admin/bookings/${id}/delete`;
        document.getElementById('delBookingRef').innerText = button.getAttribute('data-ref') || '';
        document.getElementById('delBookingCustomer').innerText = button.getAttribute('data-name') || '';
        document.getElementById('delBookingService').innerText = button.getAttribute('data-service') || '';
        document.getElementById('delBookingSchedule').innerText = `${button.getAttribute('data-date')} at ${button.getAttribute('data-time')}`;
      });
    }
  </script>
</body>
</html>
