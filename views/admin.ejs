  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // ======================================================
    // DUAL IMAGE INPUT — Shared helper logic
    // ======================================================
    const MAX_UPLOAD_BYTES = 5 * 1024 * 1024; // 5 MB
    const ALLOWED_EXTS = /\.(jpg|jpeg|png|webp)$/i;
    const ALLOWED_TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];

    /**
     * Switches the image input mode (url | upload) for a given prefix (add | edit).
     */
    function switchImageMode(prefix, mode) {
      const switcher = document.getElementById(prefix + 'ImgSwitcher');
      const urlPane = document.getElementById(prefix + 'ImgUrlPane');
      const uploadPane = document.getElementById(prefix + 'ImgUploadPane');
      if (!switcher || !urlPane || !uploadPane) return;

      switcher.querySelectorAll('.img-mode-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.mode === mode);
      });

      urlPane.style.display = mode === 'url' ? '' : 'none';
      uploadPane.style.display = mode === 'upload' ? '' : 'none';
    }

    /**
     * Shows a live URL preview after debounce.
     */
    function setupUrlPreview(inputId, previewWrapId, previewImgId) {
      const input = document.getElementById(inputId);
      const wrap = document.getElementById(previewWrapId);
      const img = document.getElementById(previewImgId);
      if (!input || !wrap || !img) return;
      let timer;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        const val = input.value.trim();
        if (!val) { wrap.style.display = 'none'; return; }
        timer = setTimeout(() => {
          img.src = val;
          img.onload = () => { wrap.style.display = 'flex'; };
          img.onerror = () => { wrap.style.display = 'none'; };
        }, 450);
      });
    }

    /**
     * Sets up drag-and-drop + click-to-browse upload zone with AJAX upload.
     */
    function setupUploadZone(prefix) {
      const fileInput = document.getElementById(prefix + 'ImageFileInput');
      const dropZone = document.getElementById(prefix + 'DropZone');
      const progressWrap = document.getElementById(prefix + 'UploadProgress');
      const progressBar = document.getElementById(prefix + 'UploadProgressBar');
      const progressText = document.getElementById(prefix + 'UploadProgressText');
      const errorBox = document.getElementById(prefix + 'UploadError');
      const previewWrap = document.getElementById(prefix + 'UploadPreviewWrap');
      const previewImg = document.getElementById(prefix + 'UploadPreviewImg');
      const clearBtn = document.getElementById(prefix + 'ClearUpload');
      const hiddenUrl = document.getElementById(prefix + 'UploadedImageUrl');
      if (!fileInput || !dropZone || !hiddenUrl) return;

      // Drag-and-drop visual feedback
      dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
      dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
      dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
      });
      fileInput.addEventListener('change', () => {
        if (fileInput.files[0]) handleFile(fileInput.files[0]);
      });
      if (clearBtn) clearBtn.addEventListener('click', clearUpload);

      function clearUpload() {
        hiddenUrl.value = '';
        if (previewWrap) previewWrap.style.display = 'none';
        if (errorBox) errorBox.style.display = 'none';
        if (progressWrap) progressWrap.style.display = 'none';
        fileInput.value = '';
      }

      function showError(msg) {
        if (errorBox) { errorBox.textContent = '⚠️ ' + msg; errorBox.style.display = 'block'; }
        if (progressWrap) progressWrap.style.display = 'none';
        if (previewWrap) previewWrap.style.display = 'none';
        hiddenUrl.value = '';
      }

      async function handleFile(file) {
        // Client-side validation
        if (!ALLOWED_TYPES.includes(file.type) || !ALLOWED_EXTS.test(file.name)) {
          return showError('Invalid file type. Only JPG, JPEG, PNG, and WebP are allowed.');
        }
        if (file.size > MAX_UPLOAD_BYTES) {
          return showError('File too large. Maximum size is 5 MB.');
        }

        // Show progress
        if (errorBox) errorBox.style.display = 'none';
        if (previewWrap) previewWrap.style.display = 'none';
        if (progressWrap) progressWrap.style.display = 'block';
        if (progressBar) { progressBar.style.width = '0%'; }
        if (progressText) progressText.textContent = 'Uploading...';
        hiddenUrl.value = '';

        // Simulate early progress for UX
        let fakeProgress = 0;
        const fakeTimer = setInterval(() => {
          fakeProgress = Math.min(fakeProgress + 8, 75);
          if (progressBar) progressBar.style.width = fakeProgress + '%';
        }, 150);

        try {
          const formData = new FormData();
          formData.append('serviceImage', file);

          const resp = await fetch('/admin/services/upload-image', {
            method: 'POST',
            body: formData
          });

          clearInterval(fakeTimer);

          if (!resp.ok && resp.status === 401) {
            return showError('Session expired. Please refresh and log in again.');
          }

          const result = await resp.json();

          if (progressBar) progressBar.style.width = '100%';
          if (progressText) progressText.textContent = result.success ? 'Upload complete!' : 'Upload failed.';

          if (!result.success) {
            return showError(result.message || 'Upload failed. Please try again.');
          }

          // Store Supabase URL in hidden field
          hiddenUrl.value = result.imageUrl;

          // Show preview
          if (previewImg) previewImg.src = result.imageUrl;
          if (previewWrap) previewWrap.style.display = 'flex';

          setTimeout(() => { if (progressWrap) progressWrap.style.display = 'none'; }, 1000);
        } catch (err) {
          clearInterval(fakeTimer);
          showError('Network error during upload. Check connection and try again.');
        }
      }
    }

