    // ========================================================
    // BOOKING CALENDAR INTERACTIVE LOGIC
    // ========================================================
    (function () {
      const serverToday = "<%= today %>"; // e.g. "2026-10-20"
      const MONTH_NAMES = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'
      ];

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function formatDayTitle(dateStr) {
        if (!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr;
        const [y, m, d] = dateStr.split('-').map(Number);
        const dateObj = new Date(Date.UTC(y, m - 1, d, 12, 0, 0));
        const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        const dayName = dayNames[dateObj.getUTCDay()];
        const monthName = MONTH_NAMES[m - 1];
        return `${dayName}, ${d} ${monthName} ${y}`;
      }

      // State
      let calYear = parseInt(serverToday.slice(0, 4), 10);
      let calMonth = parseInt(serverToday.slice(5, 7), 10); // 1-12
      let calSelectedDate = serverToday;
      let calDaysCache = {};
      let calInitialLoaded = false;

      // DOM Elements
      const calMonthPicker = document.getElementById('calMonthPicker');
      const calMonthTitle = document.getElementById('calMonthTitle');
      const calMonthTotalBadge = document.getElementById('calMonthTotalBadge');
      const calMonthStatusBadges = document.getElementById('calMonthStatusBadges');
      const calGrid = document.getElementById('calGrid');
      const calPrevBtn = document.getElementById('calPrevBtn');
      const calNextBtn = document.getElementById('calNextBtn');
      const calTodayBtn = document.getElementById('calTodayBtn');
      const calRefreshBtn = document.getElementById('calRefreshBtn');
      const calDateType = document.getElementById('calDateType');
      const calStatusFilter = document.getElementById('calStatusFilter');

      const calRangeToggle = document.getElementById('calRangeToggle');
      const calRangeInputsContainer = document.getElementById('calRangeInputsContainer');
      const calRangeStart = document.getElementById('calRangeStart');
      const calRangeEnd = document.getElementById('calRangeEnd');
      const calRangeApplyBtn = document.getElementById('calRangeApplyBtn');
      const calRangeHint = document.getElementById('calRangeHint');

      const calSelectedDateHeader = document.getElementById('calSelectedDateHeader');
      const calSelectedDateSubtext = document.getElementById('calSelectedDateSubtext');
      const calSelectedCountBadge = document.getElementById('calSelectedCountBadge');
      const calDetailLoading = document.getElementById('calDetailLoading');
      const calDetailError = document.getElementById('calDetailError');
      const calDetailRetryBtn = document.getElementById('calDetailRetryBtn');
      const calDetailEmpty = document.getElementById('calDetailEmpty');
      const calBookingsList = document.getElementById('calBookingsList');

      function updateMonthPickerValue() {
        if (calMonthPicker) {
          const mStr = String(calMonth).padStart(2, '0');
          calMonthPicker.value = `${calYear}-${mStr}`;
        }
      }

      async function fetchCalendarSummary() {
        if (!calGrid) return;
        const monthStr = String(calMonth).padStart(2, '0');
        if (calMonthTitle) calMonthTitle.innerText = `${MONTH_NAMES[calMonth - 1]} ${calYear}`;
        if (calMonthTotalBadge) calMonthTotalBadge.innerText = 'Loading...';

        const dateType = calDateType ? calDateType.value : 'appointment';
        const statusVal = calStatusFilter ? calStatusFilter.value : '';

        try {
          const res = await fetch(`/admin/api/calendar?year=${calYear}&month=${calMonth}&dateType=${dateType}&status=${encodeURIComponent(statusVal)}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (!data.success) throw new Error(data.message || 'Error fetching calendar summary');

          calDaysCache = data.days || {};
          if (calMonthTotalBadge) {
            calMonthTotalBadge.innerText = `${data.totalBookings || 0} Total in ${MONTH_NAMES[calMonth - 1]}`;
          }

          if (calMonthStatusBadges && data.statusCounts) {
            calMonthStatusBadges.innerHTML = `
              <span class="badge bg-warning text-dark" title="Pending">${data.statusCounts.pending || 0} P</span>
              <span class="badge bg-success" title="Confirmed">${data.statusCounts.confirmed || 0} C</span>
              <span class="badge bg-primary" title="Completed">${data.statusCounts.completed || 0} Done</span>
            `;
          }

          renderGrid();
        } catch (err) {
          console.error('[Calendar Summary Error]', err);
          if (calMonthTotalBadge) calMonthTotalBadge.innerText = 'Error loading';
          renderGrid(); // render cells with what we have
        }
      }

      function renderGrid() {
        if (!calGrid) return;
        calGrid.innerHTML = '';

        // Calculate day 1 offset (0=Sun, 1=Mon, ..., 6=Sat)
        const firstDayObj = new Date(Date.UTC(calYear, calMonth - 1, 1, 12, 0, 0));
        const firstDayOfWeek = firstDayObj.getUTCDay();

        // Days in current month
        const daysInMonth = new Date(Date.UTC(calYear, calMonth, 0, 12, 0, 0)).getUTCDate();

        // Days in previous month
        const daysInPrevMonth = new Date(Date.UTC(calYear, calMonth - 1, 0, 12, 0, 0)).getUTCDate();

        // 1. Previous month trailing days
        for (let i = firstDayOfWeek - 1; i >= 0; i--) {
          const prevDay = daysInPrevMonth - i;
          const prevMonthNum = calMonth === 1 ? 12 : calMonth - 1;
          const prevYearNum = calMonth === 1 ? calYear - 1 : calYear;
          const dStr = `${prevYearNum}-${String(prevMonthNum).padStart(2, '0')}-${String(prevDay).padStart(2, '0')}`;

          const cell = createDayCell(dStr, prevDay, true);
          calGrid.appendChild(cell);
        }

        // 2. Current month days
        for (let day = 1; day <= daysInMonth; day++) {
          const dStr = `${calYear}-${String(calMonth).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          const cell = createDayCell(dStr, day, false);
          calGrid.appendChild(cell);
        }

        // 3. Next month leading days (to complete grid to multiple of 7, up to 35 or 42 cells)
        const totalRendered = firstDayOfWeek + daysInMonth;
        const remaining = (totalRendered % 7 === 0) ? 0 : 7 - (totalRendered % 7);
        for (let nextDay = 1; nextDay <= remaining; nextDay++) {
          const nextMonthNum = calMonth === 12 ? 1 : calMonth + 1;
          const nextYearNum = calMonth === 12 ? calYear + 1 : calYear;
          const dStr = `${nextYearNum}-${String(nextMonthNum).padStart(2, '0')}-${String(nextDay).padStart(2, '0')}`;

          const cell = createDayCell(dStr, nextDay, true);
          calGrid.appendChild(cell);
        }
      }

      function createDayCell(dateStr, dayNumber, isOutside) {
        const cell = document.createElement('div');
        cell.className = 'calendar-day';
        if (isOutside) cell.classList.add('is-outside');
        if (dateStr === serverToday) cell.classList.add('is-today');
        if (dateStr === calSelectedDate) cell.classList.add('is-selected');

        const dayData = calDaysCache[dateStr] || null;
        const total = dayData ? dayData.total : 0;

        let badgesHtml = '';
        if (total > 0) {
          badgesHtml = `
            <div class="cal-booking-badge"><span class="cal-booking-num">${total}</span><span class="cal-booking-badge-text"> booking${total > 1 ? 's' : ''}</span></div>
            <div class="cal-status-row">
              ${dayData.pending > 0 ? `<span class="cal-status-dot cal-dot-pending" title="${dayData.pending} Pending">🟡${dayData.pending}</span>` : ''}
              ${dayData.confirmed > 0 ? `<span class="cal-status-dot cal-dot-confirmed" title="${dayData.confirmed} Confirmed">🟢${dayData.confirmed}</span>` : ''}
              ${dayData.completed > 0 ? `<span class="cal-status-dot cal-dot-completed" title="${dayData.completed} Completed">🔵${dayData.completed}</span>` : ''}
              ${dayData.cancelled > 0 ? `<span class="cal-status-dot cal-dot-cancelled" title="${dayData.cancelled} Cancelled">⚪${dayData.cancelled}</span>` : ''}
              ${dayData.rejected > 0 ? `<span class="cal-status-dot cal-dot-rejected" title="${dayData.rejected} Rejected">🔴${dayData.rejected}</span>` : ''}
            </div>
          `;
        } else {
          badgesHtml = `<div class="text-muted small fst-italic" style="opacity: 0.35;">—</div>`;
        }

        cell.innerHTML = `
          <div class="cal-day-header">
            <span class="cal-day-num">${dayNumber}</span>
            ${dateStr === serverToday ? '<span class="cal-today-tag">TODAY</span>' : ''}
          </div>
          <div>${badgesHtml}</div>
        `;

        cell.addEventListener('click', function () {
          // Unselect previous
          document.querySelectorAll('.calendar-day.is-selected').forEach(el => el.classList.remove('is-selected'));
          cell.classList.add('is-selected');

          calSelectedDate = dateStr;
          fetchDateBookings(dateStr);
        });

        return cell;
      }

      async function fetchDateBookings(dateStart, dateEnd) {
        if (!calBookingsList) return;

        // Reset UI states
        if (calDetailLoading) calDetailLoading.style.display = 'block';
        if (calDetailError) calDetailError.style.display = 'none';
        if (calDetailEmpty) calDetailEmpty.style.display = 'none';
        calBookingsList.innerHTML = '';

        const dateType = calDateType ? calDateType.value : 'appointment';
        const statusVal = calStatusFilter ? calStatusFilter.value : '';

        const isRange = dateEnd && dateEnd !== dateStart;
        if (calSelectedDateHeader) {
          calSelectedDateHeader.innerText = isRange
            ? `📅 ${dateStart} to ${dateEnd}`
            : `📅 ${formatDayTitle(dateStart)}`;
        }
        if (calSelectedDateSubtext) {
          calSelectedDateSubtext.innerText = dateType === 'created'
            ? 'Filtered by Record Created Date (Asia/Phnom_Penh)'
            : 'Filtered by Appointment Date (Asia/Phnom_Penh)';
        }

        let url = `/admin/api/calendar/bookings?date=${dateStart}&dateType=${dateType}`;
        if (isRange) url += `&dateEnd=${dateEnd}`;
        if (statusVal) url += `&status=${encodeURIComponent(statusVal)}`;

        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (!data.success) throw new Error(data.message || 'Failed to fetch bookings');

          if (calDetailLoading) calDetailLoading.style.display = 'none';

          if (calSelectedCountBadge) {
            calSelectedCountBadge.innerText = `${data.count} Booking${data.count === 1 ? '' : 's'}`;
          }

          if (!data.bookings || data.bookings.length === 0) {
            if (calDetailEmpty) calDetailEmpty.style.display = 'block';
            return;
          }

          renderBookingsCards(data.bookings);
        } catch (err) {
          console.error('[Calendar Bookings Fetch Error]', err);
          if (calDetailLoading) calDetailLoading.style.display = 'none';
          if (calDetailError) calDetailError.style.display = 'block';
        }
      }

      function renderBookingsCards(bookings) {
        calBookingsList.innerHTML = '';

        bookings.forEach(b => {
          const card = document.createElement('div');
          card.className = `cal-booking-card status-${b.status}`;

          let actionButtons = '';
          if (b.status === 'pending') {
            actionButtons = `
              <form method="post" action="/admin/bookings/${b.id}/status" class="d-inline">
                <input type="hidden" name="status" value="confirmed">
                <button type="submit" class="btn btn-sm btn-success px-2 py-1 me-1">✓ Confirm</button>
              </form>
              <form method="post" action="/admin/bookings/${b.id}/status" class="d-inline">
                <input type="hidden" name="status" value="rejected">
                <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1 me-1">✕ Reject</button>
              </form>
            `;
          } else if (b.status === 'confirmed') {
            actionButtons = `
              <form method="post" action="/admin/bookings/${b.id}/status" class="d-inline">
                <input type="hidden" name="status" value="completed">
                <button type="submit" class="btn btn-sm btn-outline-primary px-2 py-1 me-1">Complete</button>
              </form>
              <form method="post" action="/admin/bookings/${b.id}/status" class="d-inline" onsubmit="return confirm('Cancel this appointment?');">
                <input type="hidden" name="status" value="cancelled">
                <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-1 me-1">Cancel</button>
              </form>
            `;
          }

          const rescheduleBtn = `
            <button type="button" class="btn btn-sm btn-light border px-2 py-1 me-1"
              data-bs-toggle="modal"
              data-bs-target="#rescheduleModal"
              data-id="${b.id}"
              data-ref="${b.bookingReference}"
              data-date="${b.date}"
              data-time="${b.time}"
              data-duration="${b.durationMinutes}"
              data-name="${escapeHtml(b.customerName)}">
              🗓️ Reschedule
            </button>
          `;

          const deleteBtn = `
            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1"
              data-bs-toggle="modal"
              data-bs-target="#deleteBookingModal"
              data-id="${b.id}"
              data-ref="${b.bookingReference}"
              data-name="${escapeHtml(b.customerName)}"
              data-service="${escapeHtml(b.service)}"
              data-date="${b.date}"
              data-time="${b.time}">
              🗑️ Delete
            </button>
          `;

          card.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
              <div>
                <strong class="text-primary font-monospace fs-6">#${escapeHtml(b.bookingReference)}</strong>
                <span class="badge-status badge-${b.status} ms-2">${b.status}</span>
              </div>
              <span class="badge bg-light text-secondary border small">${escapeHtml(b.source).toUpperCase()}</span>
            </div>
            
            <div class="mb-1">
              <span class="fw-bold text-dark fs-6">${escapeHtml(b.customerName)}</span>
              <a href="tel:${escapeHtml(b.phone)}" class="text-decoration-none text-secondary ms-2 small">📞 ${escapeHtml(b.phone)}</a>
              ${b.telegramId ? `<span class="badge bg-primary-subtle text-primary ms-1 small">✈️ ID: ${escapeHtml(b.telegramId)}</span>` : ''}
            </div>

            <div class="d-flex justify-content-between align-items-center small mb-1">
              <div>
                <strong>💅 ${escapeHtml(b.service)}</strong>
                ${b.serviceKm ? `<span class="text-muted ms-1">(${escapeHtml(b.serviceKm)})</span>` : ''}
              </div>
              <div class="text-danger fw-bold fs-6">$${b.price}</div>
            </div>

            <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
              <div>
                ⏰ <strong>${b.date} &bull; ${b.time} - ${b.endTime}</strong> (${b.durationMinutes}m)
              </div>
              ${b.createdDatePhnomPenh ? `<div class="fst-italic" style="font-size: 0.75rem;">Booked: ${b.createdDatePhnomPenh}</div>` : ''}
            </div>

            ${b.notes ? `<div class="small text-muted fst-italic mb-2 bg-light p-2 rounded">"${escapeHtml(b.notes)}"</div>` : ''}
            ${b.adminNotes ? `<div class="small text-secondary mb-2 bg-warning-subtle p-2 rounded"><strong>Admin:</strong> ${escapeHtml(b.adminNotes)}</div>` : ''}

            <div class="d-flex flex-wrap justify-content-end align-items-center gap-1 pt-2 border-top">
              ${actionButtons}
              ${rescheduleBtn}
              ${deleteBtn}
            </div>
          `;

          calBookingsList.appendChild(card);
        });
      }

      function initEventListeners() {
        if (calPrevBtn) {
          calPrevBtn.addEventListener('click', function () {
            if (calMonth === 1) {
              calMonth = 12;
              calYear -= 1;
            } else {
              calMonth -= 1;
            }
            updateMonthPickerValue();
            fetchCalendarSummary();
            // Default selected date to 1st of new month
            calSelectedDate = `${calYear}-${String(calMonth).padStart(2, '0')}-01`;
            fetchDateBookings(calSelectedDate);
          });
        }

        if (calNextBtn) {
          calNextBtn.addEventListener('click', function () {
            if (calMonth === 12) {
              calMonth = 1;
              calYear += 1;
            } else {
              calMonth += 1;
            }
            updateMonthPickerValue();
            fetchCalendarSummary();
            // Default selected date to 1st of new month
            calSelectedDate = `${calYear}-${String(calMonth).padStart(2, '0')}-01`;
            fetchDateBookings(calSelectedDate);
          });
        }

        if (calTodayBtn) {
          calTodayBtn.addEventListener('click', function () {
            calYear = parseInt(serverToday.slice(0, 4), 10);
            calMonth = parseInt(serverToday.slice(5, 7), 10);
            calSelectedDate = serverToday;
            updateMonthPickerValue();
            fetchCalendarSummary();
            fetchDateBookings(serverToday);
          });
        }

        if (calRefreshBtn) {
          calRefreshBtn.addEventListener('click', function () {
            fetchCalendarSummary();
            fetchDateBookings(calSelectedDate);
          });
        }

        if (calMonthPicker) {
          calMonthPicker.addEventListener('change', function () {
            if (this.value && /^\d{4}-\d{2}$/.test(this.value)) {
              const [y, m] = this.value.split('-').map(Number);
              calYear = y;
              calMonth = m;
              fetchCalendarSummary();
              calSelectedDate = `${calYear}-${String(calMonth).padStart(2, '0')}-01`;
              fetchDateBookings(calSelectedDate);
            }
          });
        }

        if (calDateType) {
          calDateType.addEventListener('change', function () {
            fetchCalendarSummary();
            fetchDateBookings(calSelectedDate);
          });
        }

        if (calStatusFilter) {
          calStatusFilter.addEventListener('change', function () {
            fetchCalendarSummary();
            fetchDateBookings(calSelectedDate);
          });
        }

        if (calRangeToggle) {
          calRangeToggle.addEventListener('change', function () {
            if (calRangeInputsContainer) {
              if (this.checked) {
                calRangeInputsContainer.style.removeProperty('display');
                if (calRangeHint) calRangeHint.innerText = 'Enter start & end date to view bookings in that date range.';
                if (calRangeStart && !calRangeStart.value) calRangeStart.value = calSelectedDate;
                if (calRangeEnd && !calRangeEnd.value) calRangeEnd.value = calSelectedDate;
              } else {
                calRangeInputsContainer.style.setProperty('display', 'none', 'important');
                if (calRangeHint) calRangeHint.innerText = 'Click any day on calendar to view that day\'s bookings.';
                fetchDateBookings(calSelectedDate);
              }
            }
          });
        }

        if (calRangeApplyBtn) {
          calRangeApplyBtn.addEventListener('click', function () {
            const start = (calRangeStart?.value || '').trim();
            const end = (calRangeEnd?.value || '').trim();
            if (!start) {
              alert('Please select a start date.');
              return;
            }
            if (end && end < start) {
              alert('End date must be greater than or equal to start date.');
              return;
            }
            fetchDateBookings(start, end || start);
          });
        }

        if (calDetailRetryBtn) {
          calDetailRetryBtn.addEventListener('click', function () {
            fetchDateBookings(calSelectedDate);
          });
        }

        // Tab activation trigger
        const calendarTabBtn = document.getElementById('calendar-tab');
        if (calendarTabBtn) {
          calendarTabBtn.addEventListener('shown.bs.tab', function () {
            if (!calInitialLoaded) {
              calInitialLoaded = true;
              updateMonthPickerValue();
              fetchCalendarSummary();
              fetchDateBookings(calSelectedDate);
            }
          });
        }
      }

      // Check if calendar tab is active on load
      const isCalendarActiveOnLoad = "<%= activeTab === 'calendar' ? 'true' : 'false' %>";
      initEventListeners();
      if (isCalendarActiveOnLoad) {
        calInitialLoaded = true;
        updateMonthPickerValue();
        fetchCalendarSummary();
        fetchDateBookings(calSelectedDate);
      }

      // Admin Mobile Drawer Interaction
      const adminToggleBtn = document.getElementById('adminMenuToggle');
      const adminDrawer = document.getElementById('adminMobileDrawer');
      if (adminToggleBtn && adminDrawer) {
        adminToggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const isOpen = adminDrawer.classList.toggle('show');
          adminToggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          adminToggleBtn.innerHTML = isOpen ? '✕' : '☰';
        });

        document.addEventListener('click', function(e) {
          if (!adminDrawer.contains(e.target) && !adminToggleBtn.contains(e.target) && adminDrawer.classList.contains('show')) {
            adminDrawer.classList.remove('show');
            adminToggleBtn.setAttribute('aria-expanded', 'false');
            adminToggleBtn.innerHTML = '☰';
          }
        });

        document.querySelectorAll('.admin-drawer-tab-btn').forEach(btn => {
          btn.addEventListener('click', function() {
            const targetId = this.getAttribute('data-tab-target');
            const tabEl = document.getElementById(targetId);
            if (tabEl) {
              const tabInstance = bootstrap.Tab.getOrCreateInstance(tabEl);
              tabInstance.show();
            }
            document.querySelectorAll('.admin-drawer-tab-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            adminDrawer.classList.remove('show');
            adminToggleBtn.setAttribute('aria-expanded', 'false');
            adminToggleBtn.innerHTML = '☰';
          });
        });
      }

      // Reset filter button helper: clears form inputs immediately
      const adminResetBtn = document.getElementById('adminResetFilterBtn');
      if (adminResetBtn) {
        adminResetBtn.addEventListener('click', function() {
          const form = adminResetBtn.closest('form');
          if (form) {
            form.querySelectorAll('input:not([type="hidden"]), select').forEach(el => el.value = '');
          }
        });
      }
    })();
  </script>
</body>

</html>