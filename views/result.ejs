<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= salonName %> | <%= success ? (lang === 'km' ? 'បានទទួលសំណើកក់' : 'Booking Received') : (lang === 'km' ? 'កក់មិនជោគជ័យ' : 'Booking Error') %></title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="salon-nav">
    <div class="container d-flex align-items-center justify-content-between">
      <a class="salon-brand" href="/">
        💅 <%= salonName %>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a class="nav-link" href="/"><%= lang === 'km' ? 'ទំព័រដើម' : 'Home' %></a>
        <a class="nav-link" href="/services"><%= lang === 'km' ? 'សេវាកម្ម' : 'Services' %></a>
        <a class="nav-link d-none d-md-inline" href="/#location"><%= lang === 'km' ? 'ទីតាំងហាង' : 'Our Location' %></a>
        <a class="nav-link" href="/status"><%= lang === 'km' ? 'ពិនិត្យការកក់' : 'Check Status' %></a>
        
        <div class="lang-switch">
          <a href="?lang=en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
          <a href="?lang=km" class="<%= lang === 'km' ? 'active' : '' %>">ខ្មែរ</a>
        </div>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="glass-card text-center p-4 p-md-5">
          <% if (success && booking) { %>
            <div class="display-3 mb-3">🎉</div>
            <h1 class="fw-bold mb-2">
              <%= lang === 'km' ? 'បានទទួលសំណើកក់ក្រចកដៃ!' : 'Fingernail Appointment Received!' %>
            </h1>
            <p class="text-secondary mb-4">
              <%= lang === 'km' ? 'សូមអរគុណ! សំណើកក់របស់អ្នកត្រូវបានរក្សាទុកក្នុងប្រព័ន្ធ និងកំពុងរង់ចាំការបញ្ជាក់ពីហាង។' : 'Thank you! Your appointment request has been submitted and is awaiting salon confirmation.' %>
            </p>

            <div class="reference-banner">
              <div class="small text-secondary fw-bold text-uppercase mb-1" style="letter-spacing: 0.1em;">
                <%= lang === 'km' ? 'លេខកូដសម្គាល់ការកក់ (Reference Number)' : 'Booking Reference Number' %>
              </div>
              <div class="ref-code"><%= booking.bookingReference %></div>
              <div class="small text-muted mt-1"><%= lang === 'km' ? 'សូមរក្សាទុកលេខកូដនេះដើម្បីពិនិត្យស្ថានភាពការណាត់' : 'Save this reference code to check your appointment status anytime.' %></div>
            </div>

            <div class="bg-light rounded-4 p-4 text-start mb-4 border">
              <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">📋 <%= lang === 'km' ? 'ព័ត៌មានលម្អិតនៃការណាត់ជួប' : 'Appointment Details' %></h6>
              <div class="row g-2 small">
                <div class="col-sm-6">
                  <span class="text-secondary"><%= lang === 'km' ? 'សេវាកម្មក្រចកដៃ៖' : 'Fingernail Service:' %></span><br>
                  <strong><%= lang === 'km' ? (booking.serviceKm || booking.service) : booking.service %></strong>
                </div>
                <div class="col-sm-6">
                  <span class="text-secondary"><%= lang === 'km' ? 'តម្លៃ៖' : 'Price:' %></span><br>
                  <strong class="text-danger fs-6">$<%= booking.price %></strong>
                </div>
                <div class="col-sm-6">
                  <span class="text-secondary"><%= lang === 'km' ? 'កាលបរិច្ឆេទ៖' : 'Date:' %></span><br>
                  <strong><%= booking.date %></strong>
                </div>
                <div class="col-sm-6">
                  <span class="text-secondary"><%= lang === 'km' ? 'ពេលវេលា៖' : 'Time Slot:' %></span><br>
                  <strong><%= booking.time %> - <%= booking.endTime %></strong> (<%= booking.durationMinutes %> <%= lang === 'km' ? 'នាទី' : 'mins' %>)
                </div>
                <div class="col-sm-6">
                  <span class="text-secondary"><%= lang === 'km' ? 'ឈ្មោះអតិថិជន៖' : 'Customer Name:' %></span><br>
                  <strong><%= booking.customerName %></strong>
                </div>
                <div class="col-sm-6">
                  <span class="text-secondary"><%= lang === 'km' ? 'លេខទូរស័ព្ទ៖' : 'Phone Number:' %></span><br>
                  <strong><%= booking.phone %></strong>
                </div>
                <div class="col-12 mt-2">
                  <span class="text-secondary"><%= lang === 'km' ? 'ស្ថានភាព៖' : 'Current Status:' %></span>
                  <span class="badge-status badge-<%= booking.status %> ms-2"><%= booking.status %></span>
                </div>
              </div>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-center">
              <a href="/status?query=<%= encodeURIComponent(booking.bookingReference) %>" class="btn-nail">
                🔍 <%= lang === 'km' ? 'ពិនិត្យស្ថានភាពការកក់' : 'View Booking Status' %>
              </a>
              <a href="/" class="btn-plum">
                🏠 <%= lang === 'km' ? 'ត្រឡប់ទៅទំព័រដើម' : 'Back to Home' %>
              </a>
            </div>

            <div class="mt-4 pt-3 border-top text-center">
              <p class="text-secondary small mb-2">
                📍 <%= lang === 'km' ? 'ស្វែងរកទីតាំងហាង ឬមើលផ្លូវធ្វើដំណើរមកកាន់យើងខ្ញុំ៖' : 'Need directions or want to find our location?' %>
              </p>
              <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2 px-3 py-2">
                <span>🗺️</span>
                <span><%= lang === 'km' ? 'មើលផ្លូវទៅហាង (Google Maps)' : 'Get Directions (Google Maps)' %></span>
                <span class="small">↗</span>
              </a>
            </div>

          <% } else { %>
            <div class="display-3 mb-3">⚠️</div>
            <h1 class="fw-bold text-danger mb-2">
              <%= lang === 'km' ? 'ការកក់មិនទាន់បានសម្រេច' : 'Booking Not Completed' %>
            </h1>
            <p class="text-secondary mb-4"><%= message %></p>
            <div class="d-flex gap-2 justify-content-center">
              <a href="/book" class="btn-nail">
                ↩️ <%= lang === 'km' ? 'ព្យាយាមកក់ម្ដងទៀត' : 'Try Booking Again' %>
              </a>
              <a href="/" class="btn btn-outline-secondary">
                🏠 <%= lang === 'km' ? 'ត្រឡប់ទៅទំព័រដើម' : 'Back to Home' %>
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <div class="container text-center">
      <p class="mb-1"><strong><%= salonName %></strong></p>
      <p class="small text-secondary mb-0">
        © <%= new Date().getFullYear() %> <%= salonName %>. <%= lang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង' : 'All rights reserved.' %>
        • <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-secondary">📍 <%= lang === 'km' ? 'ទីតាំងហាង (Google Maps)' : 'Our Location (Google Maps)' %></a>
      </p>
    </div>
  </footer>
</body>
</html>
