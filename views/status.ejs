<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= salonName %> | <%= lang === 'km' ? 'ពិនិត្យស្ថានភាពការកក់' : 'Check Booking Status' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="salon-nav">
    <div class="container d-flex align-items-center justify-content-between">
      <a class="salon-brand" href="/">
        💅 <%= salonName %>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a class="nav-link" href="/"><%= lang === 'km' ? 'ទំព័រដើម' : 'Home' %></a>
        <a class="nav-link" href="/services"><%= lang === 'km' ? 'សេវាកម្ម' : 'Services' %></a>
        <a class="nav-link active" href="/status"><%= lang === 'km' ? 'ពិនិត្យការកក់' : 'Check Status' %></a>
        
        <div class="lang-switch">
          <a href="?lang=en<%= query ? '&query=' + encodeURIComponent(query) : '' %>" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
          <a href="?lang=km<%= query ? '&query=' + encodeURIComponent(query) : '' %>" class="<%= lang === 'km' ? 'active' : '' %>">ខ្មែរ</a>
        </div>

        <a class="btn-nail btn-sm d-none d-sm-inline-flex" href="/book">
          <%= lang === 'km' ? 'កក់ណាត់ជួប' : 'Book Appointment' %>
        </a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="text-center mb-4">
          <span class="hero-eyebrow">🔍 <%= lang === 'km' ? 'ពិនិត្យមើលការណាត់ជួប' : 'APPOINTMENT LOOKUP' %></span>
          <h1 class="fw-bold mt-1"><%= lang === 'km' ? 'ពិនិត្យស្ថានភាពការកក់ក្រចកដៃ' : 'Check Booking Status' %></h1>
          <p class="text-secondary"><%= lang === 'km' ? 'បញ្ចូលលេខកូដ Reference (ឧទាហរណ៍៖ NL-XXXXXX) ឬលេខទូរស័ព្ទរបស់អ្នក' : 'Enter your Booking Reference (e.g. NL-XXXXXX) or your Phone number to look up your appointment status.' %></p>
        </div>

        <div class="glass-card mb-4 p-4">
          <form method="get" action="/status" class="row g-2">
            <input type="hidden" name="lang" value="<%= lang %>">
            <div class="col-sm-9">
              <input type="text" name="query" class="form-control form-control-lg" placeholder="<%= lang === 'km' ? 'បញ្ចូលលេខកូដ NL-XXXXXX ឬលេខទូរស័ព្ទ...' : 'Enter NL-XXXXXX or Phone Number...' %>" value="<%= query %>" required>
            </div>
            <div class="col-sm-3">
              <button type="submit" class="btn-nail w-100 h-100 py-2">
                🔍 <%= lang === 'km' ? 'ស្វែងរក' : 'Search' %>
              </button>
            </div>
          </form>
        </div>

        <% if (searched) { %>
          <% if (bookings.length === 0) { %>
            <div class="glass-card text-center py-5">
              <div class="fs-1 mb-2">🔎</div>
              <h4 class="fw-bold"><%= lang === 'km' ? 'រកមិនឃើញការកក់ទេ' : 'No Bookings Found' %></h4>
              <p class="text-secondary small mb-3"><%= lang === 'km' ? 'សូមពិនិត្យមើលលេខកូដ ឬលេខទូរស័ព្ទម្ដងទៀត។' : 'Please check your booking reference code or phone number and try again.' %></p>
              <a href="/book" class="btn-nail"><%= lang === 'km' ? 'កក់សេវាកម្មថ្មី' : 'Book New Appointment' %></a>
            </div>
          <% } else { %>
            <div class="d-flex flex-column gap-3">
              <% bookings.forEach(b => { %>
                <div class="glass-card p-4">
                  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 border-bottom pb-3 mb-3">
                    <div>
                      <span class="text-secondary small"><%= lang === 'km' ? 'លេខកូដសម្គាល់៖' : 'Reference:' %></span>
                      <strong class="fs-5 text-dark ms-1"><%= b.bookingReference %></strong>
                      <span class="badge bg-light text-secondary ms-2"><%= b.source.toUpperCase() %></span>
                    </div>
                    <div>
                      <span class="badge-status badge-<%= b.status %> fs-6 px-3 py-1">
                        <%= b.status === 'pending' ? (lang === 'km' ? 'កំពុងរង់ចាំការបញ្ជាក់ (Pending)' : 'Pending Confirmation') :
                            b.status === 'confirmed' ? (lang === 'km' ? 'បានបញ្ជាក់ (Confirmed)' : 'Confirmed') :
                            b.status === 'rejected' ? (lang === 'km' ? 'បានបដិសេធ (Rejected)' : 'Rejected') :
                            b.status === 'cancelled' ? (lang === 'km' ? 'បានបោះបង់ (Cancelled)' : 'Cancelled') :
                            (lang === 'km' ? 'បានបញ្ចប់ (Completed)' : 'Completed') %>
                      </span>
                    </div>
                  </div>

                  <div class="row g-3 small">
                    <div class="col-sm-6">
                      <span class="text-secondary">💅 <%= lang === 'km' ? 'សេវាកម្មក្រចកដៃ៖' : 'Fingernail Service:' %></span><br>
                      <strong class="fs-6"><%= lang === 'km' ? (b.serviceKm || b.service) : b.service %></strong>
                      <div class="text-danger fw-bold">$<%= b.price %></div>
                    </div>
                    <div class="col-sm-6">
                      <span class="text-secondary">📅 <%= lang === 'km' ? 'ថ្ងៃនិងម៉ោងណាត់ជួប៖' : 'Appointment Time:' %></span><br>
                      <strong class="fs-6"><%= b.date %></strong><br>
                      <span class="text-dark">⏰ <%= b.time %> - <%= b.endTime %> (<%= b.durationMinutes %> <%= lang === 'km' ? 'នាទី' : 'mins' %>)</span>
                    </div>
                    <div class="col-sm-6">
                      <span class="text-secondary">👤 <%= lang === 'km' ? 'ឈ្មោះអតិថិជន៖' : 'Customer Name:' %></span><br>
                      <strong><%= b.customerName %></strong> (<%= b.phone %>)
                    </div>
                    <div class="col-sm-6">
                      <span class="text-secondary">ℹ️ <%= lang === 'km' ? 'ការណែនាំ៖' : 'Notice:' %></span><br>
                      <% if (b.status === 'pending') { %>
                        <span class="text-warning-emphasis"><%= lang === 'km' ? 'ហាងកំពុងពិនិត្យសំណើរបស់អ្នក។ អ្នកនឹងទទួលបានការជូនដំណឹងនៅពេលហាងបានបញ្ជាក់។' : 'Your appointment is awaiting salon confirmation.' %></span>
                      <% } else if (b.status === 'confirmed') { %>
                        <span class="text-success"><%= lang === 'km' ? 'ការកក់បានជោគជ័យ! សូមអញ្ជើញមកដល់មុនម៉ោង 5-10 នាទី។' : 'Appointment confirmed! Please arrive 5-10 minutes early.' %></span>
                      <% } else if (b.status === 'rejected') { %>
                        <span class="text-danger"><%= lang === 'km' ? 'ហាងមិនអាចទទួលម៉ោងនេះបានទេ។ សូមកក់ម៉ោងផ្សេង ឬទាក់ទងមកកាន់ហាង។' : 'The salon could not accept this slot. Please pick another time.' %></span>
                      <% } else { %>
                        <span class="text-muted"><%= b.status %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </main>

  <footer>
    <div class="container text-center">
      <p class="mb-1"><strong><%= salonName %></strong></p>
      <p class="small text-secondary mb-0">© <%= new Date().getFullYear() %> <%= salonName %>. <%= lang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង' : 'All rights reserved.' %></p>
    </div>
  </footer>
</body>
</html>
