<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= salonName %> | <%= lang === 'km' ? 'ពិនិត្យស្ថានភាពការកក់' : 'Check Booking Status' %></title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="has-bottom-nav">
  <!-- Top Navigation (Compact, App-Like) -->
  <nav class="salon-nav">
    <div class="container d-flex align-items-center justify-content-between position-relative">
      <a class="salon-brand" href="/?lang=<%= lang %>">
        <span class="brand-logo-icon">💅</span>
        <span><%= salonName %></span>
      </a>

      <div class="d-flex align-items-center gap-2 gap-md-3">
        <a class="nav-link d-none d-md-inline" href="/?lang=<%= lang %>"><%= lang === 'km' ? 'ទំព័រដើម' : 'Home' %></a>
        <a class="nav-link d-none d-md-inline" href="/services?lang=<%= lang %>"><%= lang === 'km' ? 'សេវាកម្ម' : 'Services' %></a>
        <a class="nav-link d-none d-md-inline" href="/?lang=<%= lang %>#location"><%= lang === 'km' ? 'ទីតាំងហាង' : 'Our Location' %></a>
        <a class="nav-link active d-none d-md-inline" href="/status?lang=<%= lang %>"><%= lang === 'km' ? 'ពិនិត្យការកក់' : 'Check Status' %></a>
        
        <div class="lang-switch">
          <a href="?lang=en<%= query ? '&query=' + encodeURIComponent(query) : '' %>" class="<%= lang === 'en' ? 'active' : '' %>" aria-label="English">EN</a>
          <a href="?lang=km<%= query ? '&query=' + encodeURIComponent(query) : '' %>" class="<%= lang === 'km' ? 'active' : '' %>" aria-label="Khmer">ខ្មែរ</a>
        </div>

        <a class="btn-nail btn-nail-sm d-none d-sm-inline-flex" href="/book?lang=<%= lang %>">
          <%= lang === 'km' ? 'កក់ណាត់ជួប' : 'Book Appointment' %>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button class="salon-menu-toggle" id="salonMenuToggle" type="button" aria-label="<%= lang==='km' ? 'បើកបញ្ជីម៉ឺនុយ' : 'Toggle navigation' %>" aria-expanded="false">
          ☰
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div class="salon-mobile-drawer" id="salonMobileDrawer">
      <div class="salon-mobile-nav-links">
        <a class="nav-link" href="/?lang=<%= lang %>">
          🏠 <%= lang==='km' ? 'ទំព័រដើម' : 'Home' %>
        </a>
        <a class="nav-link" href="/services?lang=<%= lang %>">
          💅 <%= lang==='km' ? 'សេវាកម្មក្រចក' : 'Nail Services' %>
        </a>
        <a class="nav-link" href="/?lang=<%= lang %>#location">
          📍 <%= lang==='km' ? 'ទីតាំងហាង' : 'Our Location' %>
        </a>
        <a class="nav-link active" href="/status?lang=<%= lang %>">
          🔍 <%= lang==='km' ? 'ពិនិត្យការកក់' : 'Check Status' %>
        </a>
        <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#profileModal">
          👤 <%= lang==='km' ? 'ព័ត៌មានអតិថិជន & ហាង' : 'Profile & Salon Info' %>
        </a>
      </div>
      <div class="salon-mobile-actions">
        <a class="btn-nail w-100 py-3 justify-content-center" href="/book?lang=<%= lang %>">
          📅 <%= lang==='km' ? 'កក់ណាត់ជួបឥឡូវនេះ' : 'Book Appointment' %>
        </a>
      </div>
    </div>
  </nav>

  <main class="container py-3 py-md-4">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-8">
        <div class="text-center mb-3 mb-md-4">
          <span class="hero-eyebrow">🔍 <%= lang === 'km' ? 'ពិនិត្យមើលការណាត់ជួប' : 'APPOINTMENT LOOKUP' %></span>
          <h1 class="fw-bold mt-1 h2"><%= lang === 'km' ? 'ពិនិត្យស្ថានភាពការកក់ក្រចកដៃ' : 'Check Booking Status' %></h1>
          <p class="text-secondary small mb-0"><%= lang === 'km' ? 'បញ្ចូលលេខកូដ Reference (ឧទាហរណ៍៖ NL-XXXXXX) ឬលេខទូរស័ព្ទរបស់អ្នក' : 'Enter your Booking Reference (e.g. NL-XXXXXX) or your Phone number to look up your appointment status.' %></p>
        </div>

        <!-- Search Box -->
        <div class="glass-card mb-4 p-3 p-sm-4">
          <form method="get" action="/status" class="row g-2">
            <input type="hidden" name="lang" value="<%= lang %>">
            <div class="col-12 col-sm-8 col-md-9">
              <input type="text" name="query" class="form-control" placeholder="<%= lang === 'km' ? 'បញ្ចូលលេខកូដ NL-XXXXXX ឬលេខទូរស័ព្ទ...' : 'Enter NL-XXXXXX or Phone Number...' %>" value="<%= query %>" required>
            </div>
            <div class="col-12 col-sm-4 col-md-3">
              <button type="submit" class="btn-nail w-100">
                🔍 <%= lang === 'km' ? 'ស្វែងរក' : 'Search' %>
              </button>
            </div>
          </form>
        </div>

        <% if (searched) { %>
          <% if (bookings.length === 0) { %>
            <div class="glass-card text-center py-4 py-md-5">
              <div class="fs-1 mb-2">🔎</div>
              <h4 class="fw-bold"><%= lang === 'km' ? 'រកមិនឃើញការកក់ទេ' : 'No Bookings Found' %></h4>
              <p class="text-secondary small mb-3"><%= lang === 'km' ? 'សូមពិនិត្យមើលលេខកូដ ឬលេខទូរស័ព្ទម្ដងទៀត។' : 'Please check your booking reference code or phone number and try again.' %></p>
              <a href="/book?lang=<%= lang %>" class="btn-nail"><%= lang === 'km' ? 'កក់សេវាកម្មថ្មី' : 'Book New Appointment' %></a>
            </div>
          <% } else { %>
            <div class="d-flex flex-column gap-3">
              <% bookings.forEach(b => { %>
                <div class="glass-card p-3 p-sm-4">
                  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom pb-3 mb-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <span class="text-secondary small"><%= lang === 'km' ? 'លេខកូដ៖' : 'Ref:' %></span>
                      <strong class="fs-5 text-dark font-monospace"><%= b.bookingReference %></strong>
                      <button type="button" class="btn btn-sm btn-light border py-0 px-2 copy-ref-btn" data-ref="<%= b.bookingReference %>" title="Copy code">
                        📋
                      </button>
                    </div>
                    <div>
                      <span class="badge-status badge-<%= b.status %>">
                        <%= b.status === 'pending' ? (lang === 'km' ? 'កំពុងរង់ចាំ (Pending)' : 'Pending') :
                            b.status === 'confirmed' ? (lang === 'km' ? 'បានបញ្ជាក់ (Confirmed)' : 'Confirmed') :
                            b.status === 'rejected' ? (lang === 'km' ? 'បានបដិសេធ (Rejected)' : 'Rejected') :
                            b.status === 'cancelled' ? (lang === 'km' ? 'បានបោះបង់ (Cancelled)' : 'Cancelled') :
                            (lang === 'km' ? 'បានបញ្ចប់ (Completed)' : 'Completed') %>
                      </span>
                    </div>
                  </div>

                  <div class="row g-3 small">
                    <div class="col-12 col-sm-6">
                      <span class="text-secondary">💅 <%= lang === 'km' ? 'សេវាកម្មក្រចកដៃ៖' : 'Fingernail Service:' %></span><br>
                      <strong class="fs-6"><%= lang === 'km' ? (b.serviceKm || b.service) : b.service %></strong>
                      <div class="text-danger fw-bold">$<%= b.price %></div>
                    </div>
                    <div class="col-12 col-sm-6">
                      <span class="text-secondary">📅 <%= lang === 'km' ? 'ថ្ងៃនិងម៉ោងណាត់ជួប៖' : 'Appointment Time:' %></span><br>
                      <strong class="fs-6"><%= b.date %></strong><br>
                      <span class="text-dark">⏰ <%= b.time %> - <%= b.endTime %> (<%= b.durationMinutes %> <%= lang === 'km' ? 'នាទី' : 'mins' %>)</span>
                    </div>
                    <div class="col-12 col-sm-6">
                      <span class="text-secondary">👤 <%= lang === 'km' ? 'ឈ្មោះអតិថិជន៖' : 'Customer Name:' %></span><br>
                      <strong><%= b.customerName %></strong> (<%= b.phone %>)
                    </div>
                    <div class="col-12 col-sm-6">
                      <span class="text-secondary">ℹ️ <%= lang === 'km' ? 'ស្ថានភាព៖' : 'Notice:' %></span><br>
                      <% if (b.status === 'pending') { %>
                        <span class="text-warning-emphasis"><%= lang === 'km' ? 'ហាងកំពុងពិនិត្យសំណើរបស់អ្នក។ អ្នកនឹងទទួលបានការជូនដំណឹងនៅពេលហាងបានបញ្ជាក់។' : 'Your appointment is awaiting salon confirmation.' %></span>
                      <% } else if (b.status === 'confirmed') { %>
                        <span class="text-success"><%= lang === 'km' ? 'ការកក់បានជោគជ័យ! សូមអញ្ជើញមកដល់មុនម៉ោង 5-10 នាទី។' : 'Appointment confirmed! Please arrive 5-10 minutes early.' %></span>
                        <div class="mt-2">
                          <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 py-1 px-3 rounded-pill" style="min-height: 38px;">
                            <span>🗺️</span>
                            <span><%= lang === 'km' ? 'មើលផ្លូវទៅហាង' : 'Get Directions' %></span>
                            <span class="small">↗</span>
                          </a>
                        </div>
                      <% } else if (b.status === 'rejected') { %>
                        <span class="text-danger"><%= lang === 'km' ? 'ហាងមិនអាចទទួលម៉ោងនេះបានទេ។ សូមកក់ម៉ោងផ្សេង ឬទាក់ទងមកកាន់ហាង។' : 'The salon could not accept this slot. Please pick another time.' %></span>
                      <% } else { %>
                        <span class="text-muted"><%= b.status %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="container text-center">
      <p class="mb-1"><strong><%= salonName %></strong></p>
      <p class="small text-secondary mb-0">
        © <%= new Date().getFullYear() %> <%= salonName %>. <%= lang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង' : 'All rights reserved.' %>
        • <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-secondary">📍 <%= lang === 'km' ? 'ទីតាំងហាង (Google Maps)' : 'Our Location (Google Maps)' %></a>
      </p>
    </div>
  </footer>

  <!-- Customer Profile & Salon Info Modal -->
  <div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-lg);">
        <div class="modal-header border-bottom pb-3" style="background: var(--bg-sand); border-top-left-radius: var(--radius-lg); border-top-right-radius: var(--radius-lg);">
          <div class="d-flex align-items-center gap-2">
            <span class="fs-4">👤</span>
            <div>
              <h5 class="modal-title fw-bold h6 mb-0" id="profileModalLabel"><%= lang === 'km' ? 'ព័ត៌មានអតិថិជន & ហាង' : 'Customer Profile & Salon' %></h5>
              <small class="text-muted"><%= salonName %></small>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-3 p-sm-4">
          <div class="glass-card-subtle mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="fw-bold small text-dark">📋 <%= lang === 'km' ? 'ព័ត៌មានដែលបានរក្សាទុក' : 'Saved Customer Info' %></span>
              <span class="badge bg-light text-secondary border small"><%= lang === 'km' ? 'ស្វ័យប្រវត្តិ' : 'Auto-Saved' %></span>
            </div>
            <div id="profileSavedDetails">
              <p class="small text-muted mb-0" id="profileNoSavedInfo">
                <%= lang === 'km' ? 'ព័ត៌មានឈ្មោះ និងលេខទូរស័ព្ទរបស់អ្នកនឹងត្រូវបានរក្សាទុកដោយស្វ័យប្រវត្តិនៅពេលកក់លើកដំបូង។' : 'Your name and phone number will be remembered here after your first booking.' %>
              </p>
              <div id="profileSavedContent" class="d-none">
                <div class="small"><strong><%= lang === 'km' ? 'ឈ្មោះ៖' : 'Name:' %></strong> <span id="profNameDisplay">-</span></div>
                <div class="small"><strong><%= lang === 'km' ? 'លេខទូរស័ព្ទ៖' : 'Phone:' %></strong> <span id="profPhoneDisplay">-</span></div>
              </div>
            </div>
          </div>

          <div class="d-flex flex-column gap-2 mb-3">
            <a href="/status?lang=<%= lang %>" class="btn btn-outline-dark d-flex align-items-center justify-content-between py-2 px-3 rounded-3" style="min-height: 46px;">
              <span class="d-flex align-items-center gap-2">
                <span>🔍</span>
                <span class="fw-bold small"><%= lang === 'km' ? 'មើលប្រវត្តិនិងស្ថានភាពការកក់' : 'View My Appointments' %></span>
              </span>
              <span>→</span>
            </a>
            <a href="https://maps.app.goo.gl/4qxBK6hFcZJoorRK7?g_st=it" target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger d-flex align-items-center justify-content-between py-2 px-3 rounded-3" style="min-height: 46px;">
              <span class="d-flex align-items-center gap-2">
                <span>🗺️</span>
                <span class="fw-bold small"><%= lang === 'km' ? 'មើលផ្លូវទៅហាង (Google Maps)' : 'Get Directions (Google Maps)' %></span>
              </span>
              <span>↗</span>
            </a>
            <a href="https://t.me/miniroomnail_bot" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-flex align-items-center justify-content-between py-2 px-3 rounded-3" style="min-height: 46px;">
              <span class="d-flex align-items-center gap-2">
                <span>✈️</span>
                <span class="fw-bold small"><%= lang === 'km' ? 'ជំនួយការកក់ Telegram Bot' : 'Telegram Booking Bot' %></span>
              </span>
              <span>↗</span>
            </a>
          </div>

          <div class="pt-2 border-top small text-secondary">
            <div>⏰ <strong><%= lang === 'km' ? 'ម៉ោងបើកហាង៖' : 'Hours:' %></strong> <%= settings.openingTime %> - <%= settings.closingTime %> (<%= lang === 'km' ? 'រៀងរាល់ថ្ងៃ' : 'Mon - Sun' %>)</div>
            <% if (settings.salonPhone) { %>
              <div class="mt-1">📞 <strong><%= lang === 'km' ? 'លេខទូរស័ព្ទ៖' : 'Phone:' %></strong> <a href="tel:<%= settings.salonPhone %>" class="text-decoration-none text-dark"><%= settings.salonPhone %></a></div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile App Bottom Navigation Bar -->
  <nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
    <a href="/?lang=<%= lang %>" class="bottom-nav-item">
      <span class="bottom-nav-icon">🏠</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'ទំព័រដើម' : 'Home' %></span>
    </a>
    <a href="/services?lang=<%= lang %>" class="bottom-nav-item">
      <span class="bottom-nav-icon">💅</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'សេវាកម្ម' : 'Services' %></span>
    </a>
    <a href="/book?lang=<%= lang %>" class="bottom-nav-item book-highlight">
      <span class="bottom-nav-icon-wrap">📅</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'កក់ណាត់' : 'Book' %></span>
    </a>
    <a href="/status?lang=<%= lang %>" class="bottom-nav-item active">
      <span class="bottom-nav-icon">🔍</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'ការកក់' : 'Bookings' %></span>
    </a>
    <a href="#" class="bottom-nav-item" data-bs-toggle="modal" data-bs-target="#profileModal">
      <span class="bottom-nav-icon">👤</span>
      <span class="bottom-nav-label"><%= lang === 'km' ? 'គណនី' : 'Profile' %></span>
    </a>
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Copy reference code button
    document.querySelectorAll('.copy-ref-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const ref = this.getAttribute('data-ref');
        if (ref && navigator.clipboard) {
          navigator.clipboard.writeText(ref).then(() => {
            const originalText = this.innerText;
            this.innerText = '✓';
            setTimeout(() => { this.innerText = originalText; }, 1500);
          });
        }
      });
    });

    // Mobile Drawer Toggle
    (function() {
      const toggleBtn = document.getElementById('salonMenuToggle');
      const drawer = document.getElementById('salonMobileDrawer');
      if (toggleBtn && drawer) {
        toggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const isOpen = drawer.classList.toggle('show');
          toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          toggleBtn.innerHTML = isOpen ? '✕' : '☰';
        });
        document.addEventListener('click', function(e) {
          if (!drawer.contains(e.target) && !toggleBtn.contains(e.target) && drawer.classList.contains('show')) {
            drawer.classList.remove('show');
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.innerHTML = '☰';
          }
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && drawer.classList.contains('show')) {
            drawer.classList.remove('show');
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.innerHTML = '☰';
          }
        });
      }
    })();
  </script>
</body>
</html>
