# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in real values
# NEVER commit your real .env file with secrets
# ==============================================================================

# Node environment ('development' locally, 'production' on Render/cloud)
NODE_ENV=development

# Server port — Render.com injects this automatically
PORT=3000

# ==============================================================================
# ---- Supabase Cloud PostgreSQL Database ----
# ==============================================================================
# Get your Project URL and service_role secret key from:
# Supabase Dashboard -> Project Settings -> API
# 
# 1. SUPABASE_URL: Your Project URL (e.g. https://xyzproject.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. SUPABASE_SERVICE_ROLE_KEY: The server-side service_role secret key.
# IMPORTANT: This key must remain private on the backend server.
# NEVER expose this key to browser client JavaScript or commit to GitHub.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# (Optional fallback key name if your deployment provides SUPABASE_KEY)
# SUPABASE_KEY=your_supabase_service_role_secret_key

# ==============================================================================
# ---- Optional: MongoDB URI (Only needed for running data migration) ----
# ==============================================================================
# Used by "npm run migrate:supabase" if importing existing MongoDB Atlas data.
# Once migration is complete, this is no longer needed by the web server.
MONGODB_URI=mongodb://127.0.0.1:27017/beauty_salon_booking

# ==============================================================================
# ---- Telegram Bot ----
# ==============================================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram Chat ID to receive new booking notifications with inline Confirm/Reject buttons
# Send /myid to your bot to get your personal numeric chat ID
ADMIN_TELEGRAM_CHAT_ID=your_admin_chat_id_here

# ==============================================================================
# ---- Admin Dashboard Authentication ----
# ==============================================================================
# Credentials for accessing /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# ==============================================================================
# ---- Salon Branding & Settings ----
# ==============================================================================
SALON_NAME=Mini Room Nail & Eyelash
SALON_PHONE=012345678

# Salon timezone for appointment date/time validation (IANA format)
SALON_TIMEZONE=Asia/Phnom_Penh
